# ==============================================================================
#  AI Bridge — Multi-Stage Production Dockerfile
# ==============================================================================

# --- Stage 1: Build Frontend Dashboard ---
FROM node:22-alpine AS frontend-builder
WORKDIR /build
COPY apps/dashboard/package*.json ./
# P-07 (Wave 7): `npm ci` (exact lockfile install), not `npm install`.
# apps/dashboard/package-lock.json exists (lockfileVersion 3); `npm ci`
# fails fast if package.json and the lockfile drift, instead of silently
# resolving floating ranges at image-build time.
RUN npm ci
COPY apps/dashboard/ ./
RUN npm run build

# --- Stage 2: Production Python Runtime ---
FROM python:3.15-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    AI_BRIDGE_DATA_DIR=/var/lib/ai-bridge \
    AI_BRIDGE_WORKSPACE=/var/lib/ai-bridge/workspace

WORKDIR /app

# Install minimal runtime system utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Install Python production dependencies
COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY migrations/ ./migrations/

# P-07 (Wave 7): the prod-only deps (gunicorn, psycopg[binary],
# prometheus-client) live pinned in pyproject.toml [prod] — they used
# to be installed here unpinned, outside pyproject.toml.
RUN pip install --no-cache-dir -e .[prod]

# Copy built dashboard assets from Stage 1
COPY --from=frontend-builder /build/dist /app/apps/dashboard/dist

# Security hardening: Create non-root user
RUN groupadd -g 1001 aibridge && \
    useradd -u 1001 -g aibridge -s /bin/bash -m aibridge && \
    mkdir -p /var/lib/ai-bridge/workspace /var/lib/ai-bridge/logs && \
    chown -R aibridge:aibridge /app /var/lib/ai-bridge

USER aibridge

EXPOSE 8000

# Health check using the readiness probe
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://127.0.0.1:8000/health/ready || exit 1

# F-05-02 (Wave 6): the worker count the control plane runs with.
# MUST match the gunicorn `-w` below. create_app() fails fast at boot
# when AI_BRIDGE_WORKERS > 1 and no shared AI_BRIDGE_CSRF_SECRET is
# configured (a per-process random secret breaks CSRF across workers).
ENV AI_BRIDGE_WORKERS=4

# Gate 13 (Wave 7): the fleet self-update target — see the comment in
# deployment/docker/Dockerfile. The image carries the repo at /app, so
# the update target is deterministic and independent of the worker's cwd.
ENV AI_BRIDGE_AGENT_REPO_DIR=/app

# Launch with Gunicorn (4 Uvicorn workers)
CMD ["gunicorn", \
     "-w", "4", \
     "-k", "uvicorn.workers.UvicornWorker", \
     "-b", "0.0.0.0:8000", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "ai_bridge.control.app:create_app()"]

