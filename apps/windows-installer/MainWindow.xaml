<Window x:Class="AIBridgeInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Bridge Windows Client Setup"
        Width="900" Height="620"
        MinWidth="820" MinHeight="560"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgCanvas}"
        Foreground="{DynamicResource TextPrimary}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="244"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT STEPPER RAIL -->
            <Border Grid.Column="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="0,0,1,0" Padding="20,22">
                <DockPanel>
                    <!-- Brand Header -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,28">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentGradient}" Margin="0,0,12,0">
                                <TextBlock Text="AI" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="AI Bridge" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Windows Client Setup" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Margin="0,14,0,0" Padding="8,4" CornerRadius="6" Background="{DynamicResource AccentSoftBg}" HorizontalAlignment="Left">
                            <TextBlock x:Name="ModeBadgeText" Text="v0.3.0 · Clean Install" FontSize="10.5" FontFamily="Consolas"
                                       FontWeight="SemiBold" Foreground="{DynamicResource AccentSoftFg}"/>
                        </Border>
                    </StackPanel>

                    <!-- Footer Info -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}"
                                BorderThickness="1" CornerRadius="10" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Security Architecture" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Per-user install (no UAC needed). Credentials sealed via Win32 DPAPI."
                                           FontSize="10.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="15"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Vertical Steps -->
                    <StackPanel x:Name="StepRailPanel">
                        <Border x:Name="RailStep0" CornerRadius="8" Padding="10,9" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="RailDot0" Width="22" Height="22" CornerRadius="11" Margin="0,0,10,0">
                                    <TextBlock x:Name="RailNum0" Text="1" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="RailLbl0" Text="Welcome" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Overview &amp; preflight" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="RailStep1" CornerRadius="8" Padding="10,9" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="RailDot1" Width="22" Height="22" CornerRadius="11" Margin="0,0,10,0">
                                    <TextBlock x:Name="RailNum1" Text="2" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="RailLbl1" Text="Location &amp; Options" FontSize="12.5" FontWeight="Medium"/>
                                    <TextBlock Text="Install path &amp; shortcuts" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="RailStep2" CornerRadius="8" Padding="10,9" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="RailDot2" Width="22" Height="22" CornerRadius="11" Margin="0,0,10,0">
                                    <TextBlock x:Name="RailNum2" Text="3" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="RailLbl2" Text="Connect &amp; Policy" FontSize="12.5" FontWeight="Medium"/>
                                    <TextBlock Text="Control plane &amp; guardrails" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="RailStep3" CornerRadius="8" Padding="10,9" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="RailDot3" Width="22" Height="22" CornerRadius="11" Margin="0,0,10,0">
                                    <TextBlock x:Name="RailNum3" Text="4" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="RailLbl3" Text="Installing" FontSize="12.5" FontWeight="Medium"/>
                                    <TextBlock Text="Deploy &amp; verify SHA-256" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="RailStep4" CornerRadius="8" Padding="10,9">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="RailDot4" Width="22" Height="22" CornerRadius="11" Margin="0,0,10,0">
                                    <TextBlock x:Name="RailNum4" Text="5" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="RailLbl4" Text="Ready" FontSize="12.5" FontWeight="Medium"/>
                                    <TextBlock Text="Summary &amp; launch" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- RIGHT CONTENT AREA -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="66"/>
                </Grid.RowDefinitions>

                <!-- Custom Draggable Titlebar -->
                <Grid Grid.Row="0" Margin="20,0,12,0">
                    <TextBlock x:Name="HeaderTitleText" Text="Welcome to AI Bridge" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="ThemeToggleBtn" Style="{StaticResource ChromeBtnStyle}" Click="OnToggleThemeClick" ToolTip="Switch Light / Dark theme" Margin="0,0,4,0">
                            <TextBlock x:Name="ThemeIconText" Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        </Button>
                        <Button Style="{StaticResource ChromeBtnStyle}" Click="OnMinimizeClick" ToolTip="Minimize" Margin="0,0,2,0">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                        </Button>
                        <Button x:Name="CloseChromeBtn" Style="{StaticResource ChromeBtnStyle}" Click="OnCloseClick" ToolTip="Close">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- STEP CONTENT HOST -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,6,28,16">
                    <Grid>
                        <!-- PAGE 0: WELCOME -->
                        <StackPanel x:Name="PageWelcome" Visibility="Visible">
                            <!-- Hero Card -->
                            <Border Background="{StaticResource HeroGradient}" CornerRadius="14" Padding="24,22" Margin="0,0,0,18"
                                    BorderBrush="#312E81" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="ENTERPRISE ENDPOINT AGENT" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="#A5B4FC" FontFamily="Consolas"/>
                                    <TextBlock Text="Install AI Bridge Windows Client" FontSize="22" FontWeight="Bold"
                                               Foreground="#F8FAFC" Margin="0,6,0,0"/>
                                    <TextBlock Text="Native C# WPF desktop agent with outbound-only control plane polling, Win32 DPAPI credential sealing, live telemetry, and policy-gated automation."
                                               FontSize="12.5" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19"/>
                                </StackPanel>
                            </Border>

                            <!-- Existing Installation Banner (hidden unless detected) -->
                            <Border x:Name="ExistingInstallBanner" Visibility="Collapsed" Background="{DynamicResource WarningBg}"
                                    BorderBrush="{DynamicResource WarningFg}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource DangerBtnStyle}" Content="Uninstall Existing"
                                            Click="OnGoToUninstallClick" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="ExistingInstallTitle" Text="Existing installation detected"
                                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource WarningFg}"/>
                                        <TextBlock x:Name="ExistingInstallSub" Text="Continue to upgrade or repair in place, or choose Uninstall."
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- 3 Feature Cards -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}"
                                        BorderThickness="1" CornerRadius="12" Padding="16">
                                    <StackPanel>
                                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSoftBg}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentSoftFg}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="DPAPI Sealed" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Device tokens are encrypted with Windows user-scoped CryptProtectData."
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="16"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}"
                                        BorderThickness="1" CornerRadius="12" Padding="16">
                                    <StackPanel>
                                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SuccessBg}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                            <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource SuccessFg}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Fail-Closed Policy" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Shell and interactive desktop control remain disabled unless opted in on both sides."
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="16"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}"
                                        BorderThickness="1" CornerRadius="12" Padding="16">
                                    <StackPanel>
                                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource WarningBg}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource WarningFg}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Zero Inbound Ports" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Outbound-only HTTPS/WSS poller with live system metrics and tray controls."
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="16"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock x:Name="PayloadStatusNote" Margin="0,16,0,0" FontSize="11.5" FontFamily="Consolas"
                                       Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>

                        <!-- PAGE 1: LOCATION & OPTIONS -->
                        <StackPanel x:Name="PageLocation" Visibility="Collapsed">
                            <TextBlock Text="Installation Location &amp; Integration" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Choose where AI Bridge Client binaries and the sandboxed workspace directory are placed."
                                       FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,18"/>

                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}"
                                    BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock x:Name="DiskSpaceText" DockPanel.Dock="Right" Text="Checking free space..."
                                                   FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource SuccessFg}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Install Folder" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="InstallDirBox" Grid.Column="0" Style="{StaticResource FieldStyle}" FontFamily="Consolas"
                                                 TextChanged="OnInstallDirTextChanged"/>
                                        <Button Grid.Column="2" Style="{StaticResource SecondaryBtnStyle}" Content="Browse..." Click="OnBrowseInstallDirClick"/>
                                    </Grid>

                                    <TextBlock Text="Default Agent Workspace Folder" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,14,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="WorkspaceDirBox" Grid.Column="0" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                        <Button Grid.Column="2" Style="{StaticResource SecondaryBtnStyle}" Content="Browse..." Click="OnBrowseWorkspaceDirClick"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}"
                                    BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Windows Shell Integration" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="ChkDesktopShortcut" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Margin="0,0,0,12"
                                              Content="Create Desktop shortcut (AI Bridge Client)"/>
                                    <CheckBox x:Name="ChkStartMenuShortcut" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Margin="0,0,0,12"
                                              Content="Create Start Menu folder &amp; Uninstaller shortcut"/>
                                    <CheckBox x:Name="ChkAutoStart" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True"
                                              Content="Start minimized in system tray when Windows signs in"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- PAGE 2: CONTROL PLANE & GUARDRAILS -->
                        <StackPanel x:Name="PageConnect" Visibility="Collapsed">
                            <TextBlock Text="Control Plane &amp; Local Guardrails" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Optional: pre-configure your Control Plane URL and one-time Device Token now, or skip and enroll inside the app later."
                                       FontSize="12.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,16"/>

                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}"
                                    BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Control Plane URL" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ControlUrlBox" Grid.Column="0" Style="{StaticResource FieldStyle}" FontFamily="Consolas"
                                                 Tag="https://control.example.com"/>
                                        <Button x:Name="TestConnBtn" Grid.Column="2" Style="{StaticResource SecondaryBtnStyle}"
                                                Content="Test Connection" Click="OnTestConnectionClick"/>
                                    </Grid>
                                    <TextBlock x:Name="ConnTestStatusText" Text="Ready to verify /health endpoint."
                                               FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextMuted}" Margin="2,6,0,0"/>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Device ID" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <TextBox x:Name="DeviceIdBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="One-Time Device Token (Optional, DPAPI Sealed)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <PasswordBox x:Name="DeviceTokenBox" Style="{StaticResource PasswordFieldStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}"
                                    BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Initial Local Policy Guardrails (Fail-Closed)" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <CheckBox x:Name="ChkAllowWrites" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Margin="0,0,0,10"
                                                      Content="Allow Tier 2 workspace writes"/>
                                            <CheckBox x:Name="ChkAllowTier3" Style="{StaticResource ToggleSwitchStyle}" IsChecked="False"
                                                      Content="Allow Tier 3 system actions"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <CheckBox x:Name="ChkAllowShell" Style="{StaticResource ToggleSwitchStyle}" IsChecked="False" Margin="0,0,0,10"
                                                      Content="Allow shell execution (run_shell)"/>
                                            <CheckBox x:Name="ChkAllowDesktop" Style="{StaticResource ToggleSwitchStyle}" IsChecked="False"
                                                      Content="Allow interactive desktop control"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- PAGE 3: PROGRESS (INSTALL OR UNINSTALL) -->
                        <StackPanel x:Name="PageProgress" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock x:Name="ProgressPercentText" DockPanel.Dock="Right" Text="0%" FontSize="20"
                                           FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource AccentSoftFg}" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock x:Name="ProgressHeadingText" Text="Installing AI Bridge Windows Client..." FontSize="19" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ProgressSubText" Text="Preparing installation..." FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <ProgressBar x:Name="MainProgressBar" Style="{StaticResource SmoothProgressStyle}" Value="0" Margin="0,4,0,18"/>

                            <!-- Step Checklist -->
                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}"
                                    BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock x:Name="ChkStepIcon0" Text="○" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource TextMuted}" Width="22"/>
                                        <TextBlock x:Name="ChkStepLbl0" Text="Preflight checks &amp; process cleanup" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock x:Name="ChkStepIcon1" Text="○" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource TextMuted}" Width="22"/>
                                        <TextBlock x:Name="ChkStepLbl1" Text="Deploy binaries &amp; native GUI uninstaller" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock x:Name="ChkStepIcon2" Text="○" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource TextMuted}" Width="22"/>
                                        <TextBlock x:Name="ChkStepLbl2" Text="Write configuration &amp; seal DPAPI token" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock x:Name="ChkStepIcon3" Text="○" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource TextMuted}" Width="22"/>
                                        <TextBlock x:Name="ChkStepLbl3" Text="Create shortcuts &amp; Windows Installed Apps entry" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ChkStepIcon4" Text="○" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource TextMuted}" Width="22"/>
                                        <TextBlock x:Name="ChkStepLbl4" Text="Verify binary SHA-256 checksum" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Live Install Console -->
                            <Border Background="{DynamicResource ConsoleBg}" BorderBrush="{DynamicResource BorderHairline}"
                                    BorderThickness="1" CornerRadius="10" Padding="12">
                                <TextBox x:Name="InstallLogBox" IsReadOnly="True" Background="Transparent" Foreground="#94A3B8"
                                         BorderThickness="0" FontFamily="Consolas" FontSize="11" Height="130"
                                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>

                        <!-- PAGE 4: COMPLETE / RESULT -->
                        <StackPanel x:Name="PageComplete" Visibility="Collapsed">
                            <Border x:Name="ResultBanner" Background="{DynamicResource SuccessBg}" BorderBrush="{DynamicResource SuccessColor}"
                                    BorderThickness="1" CornerRadius="14" Padding="22,20" Margin="0,0,0,18">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="ResultIconBg" Width="46" Height="46" CornerRadius="23" Background="{DynamicResource SuccessColor}" Margin="0,0,16,0">
                                        <TextBlock x:Name="ResultIconGlyph" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                                   Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="ResultHeadingText" Text="AI Bridge Client Installed!" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock x:Name="ResultMessageText" Text="Ready to connect to your Control Plane."
                                                   FontSize="12.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxWidth="460" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="SummaryCard" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}"
                                    BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Installation Summary" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <DockPanel Margin="0,0,0,7">
                                        <TextBlock Text="Install Path" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="SummaryPathText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                   FontSize="11.5" FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,7">
                                        <TextBlock Text="Control Plane" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="SummaryControlText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                   FontSize="11.5" FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,7">
                                        <TextBlock Text="Binary SHA-256" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="SummaryShaText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                   FontSize="11.5" FontFamily="Consolas" Foreground="{DynamicResource SuccessFg}"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Windows Startup" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="SummaryStartupText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                   FontSize="11.5" FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <CheckBox x:Name="ChkLaunchNow" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True"
                                      Content="Launch AI Bridge Windows Client when Setup closes"/>
                        </StackPanel>

                        <!-- PAGE 5: UNINSTALL CONFIRMATION -->
                        <StackPanel x:Name="PageUninstall" Visibility="Collapsed">
                            <Border Background="{DynamicResource DangerBg}" BorderBrush="{DynamicResource DangerBorder}"
                                    BorderThickness="1" CornerRadius="14" Padding="22,20" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="UNINSTALL AI BRIDGE WINDOWS CLIENT" FontSize="10.5" FontFamily="Consolas"
                                               FontWeight="SemiBold" Foreground="{DynamicResource DangerFg}"/>
                                    <TextBlock Text="Remove AI Bridge from this workstation" FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="UninstallTargetText" Text="This will stop the running client, remove shortcuts, startup entries, and application binaries."
                                               FontSize="12.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}"
                                    BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="User Data &amp; Credentials" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="ChkKeepConfig" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True"
                                              Content="Keep my ~/.ai-bridge configuration, DPAPI token, and audit logs"/>
                                    <TextBlock Text="Turn this off to perform a complete wipe of all local AI Bridge data on this PC."
                                               FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="48,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- FOOTER ACTION BAR -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="0,1,0,0" Padding="24,0">
                    <DockPanel LastChildFill="False">
                        <Button x:Name="BackBtn" DockPanel.Dock="Left" Style="{StaticResource SecondaryBtnStyle}"
                                Content="← Back" Click="OnBackClick" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <Button x:Name="CancelBtn" DockPanel.Dock="Left" Style="{StaticResource SecondaryBtnStyle}"
                                Content="Cancel" Click="OnCloseClick" VerticalAlignment="Center" Margin="8,0,0,0"/>

                        <Button x:Name="NextBtn" DockPanel.Dock="Right" Style="{StaticResource PrimaryBtnStyle}"
                                Content="Get Started →" Click="OnNextClick" VerticalAlignment="Center"/>
                        <Button x:Name="UninstallActionBtn" DockPanel.Dock="Right" Style="{StaticResource DangerBtnStyle}"
                                Content="Uninstall Now" Click="OnConfirmUninstallClick" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
