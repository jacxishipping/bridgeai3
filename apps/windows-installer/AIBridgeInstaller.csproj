<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>AIBridgeSetup</AssemblyName>
    <RootNamespace>AIBridgeInstaller</RootNamespace>
    <Version>0.3.0</Version>
    <Product>AI Bridge Windows Client Setup</Product>
    <Company>AI Bridge</Company>
    <Description>Native C# WPF Installer and Uninstaller for the AI Bridge Windows Client</Description>
  </PropertyGroup>

  <ItemGroup Condition="Exists('Payload\AIBridgeClientPayload.zip')">
    <EmbeddedResource Include="Payload\AIBridgeClientPayload.zip" LogicalName="AIBridgeInstaller.Payload.zip" />
  </ItemGroup>

</Project>
