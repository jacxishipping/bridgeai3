<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AIBridgeClient</AssemblyName>
    <RootNamespace>AIBridgeClient</RootNamespace>
    <Version>0.3.0</Version>
    <Product>AI Bridge Windows Client</Product>
    <Description>Native C# WPF Windows Client for AI Bridge</Description>
  </PropertyGroup>

</Project>
