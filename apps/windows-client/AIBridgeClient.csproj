<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>AIBridgeClient</AssemblyName>
    <RootNamespace>AIBridgeClient</RootNamespace>
    <Version>0.3.0</Version>
    <Product>AI Bridge Windows Client</Product>
    <Description>Native C# WPF Windows Client for AI Bridge</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\windows-agent\build\Release\ai_bridge_native.dll"
          Condition="Exists('..\..\windows-agent\build\Release\ai_bridge_native.dll')"
          Link="ai_bridge_native.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\windows-agent\build\Release\ai_bridge_desktop.exe"
          Condition="Exists('..\..\windows-agent\build\Release\ai_bridge_desktop.exe')"
          Link="ai_bridge_desktop.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\windows-agent\build\Release\ai_bridge_service.exe"
          Condition="Exists('..\..\windows-agent\build\Release\ai_bridge_service.exe')"
          Link="ai_bridge_service.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\windows-agent\build\Release\ai_bridge_tests.exe"
          Condition="Exists('..\..\windows-agent\build\Release\ai_bridge_tests.exe')"
          Link="ai_bridge_tests.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
