<Window x:Class="AIBridgeClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Bridge — Minimal Enterprise Windows Control Plane"
        Width="1300" Height="840"
        MinWidth="740" MinHeight="560"
        Background="{DynamicResource BgCanvas}"
        Foreground="{DynamicResource TextPrimary}"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        SizeChanged="OnWindowSizeChanged"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Emergency All-Stop Banner -->
            <Border x:Name="EmergencyBanner" Grid.Row="0" Visibility="Collapsed" Background="#7F1D1D" BorderBrush="#EF4444" BorderThickness="0,0,0,1" Padding="18,9">
                <DockPanel>
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#FCA5A5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="EMERGENCY ALL-STOP ACTIVE — Remote task execution is suspended by the Control Plane."
                               FontSize="12.5" FontWeight="SemiBold" Foreground="#FEF2F2" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- App Shell: 224px Sidebar + Fluid Main Column -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="224"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="0,0,1,0" Padding="12,16">
                    <DockPanel>
                        <!-- Brand Row -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,24">
                            <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource AccentPrimary}" Margin="0,0,10,0">
                                <TextBlock Text="AI" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel x:Name="SidebarBrandText" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="AI Bridge" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Text="v0.3.0" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource TextMuted}" Margin="7,2,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Bottom Control Plane Card + Footer Version -->
                        <StackPanel DockPanel.Dock="Bottom">
                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="12"
                                    Cursor="Hand" MouseLeftButtonUp="OnOpenNodeDrawerClick" ToolTip="Inspect workstation details">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SidebarLinkTitle" Grid.Column="0" Text="Control Plane Link" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}"/>
                                        <Ellipse x:Name="SidebarStatusDot" Grid.Column="1" Width="6" Height="6" Fill="#94A3B8" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="SidebarStatusText" Text="Disconnected" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="SidebarLinkSub" Text="Outbound-only poller" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="SidebarFooterVersion" Text="AI Bridge v0.3.0" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="6,10,0,0"/>
                        </StackPanel>

                        <!-- Navigation -->
                        <StackPanel>
                            <TextBlock x:Name="NavGroupOpsText" Text="OPERATIONS" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource TextMuted}" Margin="10,0,0,6"/>

                            <Button x:Name="NavOverviewBtn" Style="{StaticResource NavButtonActiveStyle}" Click="OnNavClick" Tag="0" Margin="0,0,0,2" ToolTip="Overview">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="NavIcon0" Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource NavActiveAccent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NavLblOverview" Text="Overview" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavTasksBtn" Style="{StaticResource NavButtonStyle}" Click="OnNavClick" Tag="1" Margin="0,0,0,2" ToolTip="Task Explorer">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="NavIcon1" Text="&#xE7C4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NavLblTasks" Text="Task Explorer" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavMonitorBtn" Style="{StaticResource NavButtonStyle}" Click="OnNavClick" Tag="2" Margin="0,0,0,2" ToolTip="System Monitor">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="NavIcon2" Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NavLblMonitor" Text="System Monitor" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavVisionBtn" Style="{StaticResource NavButtonStyle}" Click="OnNavClick" Tag="3" Margin="0,0,0,2" ToolTip="Desktop Vision">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="NavIcon3" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NavLblVision" Text="Desktop Vision" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavAgentsBtn" Style="{StaticResource NavButtonStyle}" Click="OnNavClick" Tag="6" Margin="0,0,0,20" ToolTip="Agents">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="NavIcon6" Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NavLblAgents" Text="Agents" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="NavGroupGovText" Text="GOVERNANCE" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource TextMuted}" Margin="10,0,0,6"/>

                            <Button x:Name="NavSecurityBtn" Style="{StaticResource NavButtonStyle}" Click="OnNavClick" Tag="4" Margin="0,0,0,2" ToolTip="Security &amp; Policy">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="NavIcon4" Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NavLblSecurity" Text="Security &amp; Policy" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavSettingsBtn" Style="{StaticResource NavButtonStyle}" Click="OnNavClick" Tag="5" ToolTip="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="NavIcon5" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NavLblSettings" Text="Settings" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- RIGHT COLUMN -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TOP BAR (48px) -->
                    <Border Grid.Row="0" Background="{DynamicResource BgCanvas}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="0,0,0,1" Padding="24,0,12,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Breadcrumb -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="&#xE700;" Style="{StaticResource CaptionBtnStyle}" Click="OnToggleSidebarClick"
                                        Margin="0,0,8,0" ToolTip="Toggle Compact Sidebar"/>
                                <TextBlock Text="AI Bridge" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Text=" / " FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="BreadcrumbPageText" Text="Overview" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Right Controls: Take Over Button, Connection Pill, Search Ctrl K, Theme Toggle, WI Avatar, Window Captions -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="TopTakeoverBtn" Content="⚡ Take Over Screen" Style="{StaticResource DangerBtnStyle}"
                                        Padding="11,4.5" FontSize="11.5" FontWeight="SemiBold" Visibility="Collapsed"
                                        WindowChrome.IsHitTestVisibleInChrome="True" Click="OnTopTakeoverClick"
                                        Margin="0,0,8,0" ToolTip="Reclaim mouse &amp; keyboard control from the AI agent (Ctrl+Alt+T)"/>

                                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1"
                                        CornerRadius="14" Padding="10,4.5" Margin="0,0,8,0" VerticalAlignment="Center"
                                        Cursor="Hand" MouseLeftButtonUp="OnOpenNodeDrawerClick" ToolTip="Open Node Inspector Drawer">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,5,0">
                                            <Ellipse x:Name="TopStatusPulse" Width="12" Height="12" Fill="#10B981" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Ellipse x:Name="TopStatusDot" Width="7" Height="7" Fill="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Name="TopStatusText" Text="Disconnected" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Button Style="{StaticResource BtnStyle}" Padding="10,4.5" FontSize="11.5"
                                        WindowChrome.IsHitTestVisibleInChrome="True" Click="OnOpenCommandPaletteClick" Margin="0,0,8,0" ToolTip="Command Palette (Ctrl+K)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Search" Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource BgElevated}" CornerRadius="4" Padding="5,1">
                                            <TextBlock Text="Ctrl K" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource TextSecondary}"/>
                                        </Border>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource BtnStyle}" Padding="7,6" WindowChrome.IsHitTestVisibleInChrome="True"
                                        Click="OnToggleThemeClick" Margin="0,0,8,0" ToolTip="Toggle Dark / Light Theme">
                                    <TextBlock x:Name="ThemeToggleIcon" Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                </Button>

                                <Button x:Name="ProfileMenuBtn" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnProfileMenuClick"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" ToolTip="Node Actions &amp; Account Menu">
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="ProfileContextMenu" Style="{StaticResource SaaSContextMenuStyle}">
                                            <MenuItem Header="Inspect Workstation Drawer" Click="OnOpenNodeDrawerMenuClick"/>
                                            <MenuItem Header="Ping Control Plane" Click="OnPingClick"/>
                                            <MenuItem Header="Sync Policy to Server" Click="OnSyncPolicyClick"/>
                                            <MenuItem Header="Export Diagnostics Bundle" Click="OnExportDiagnosticsBundleClick"/>
                                            <Separator/>
                                            <MenuItem Header="Open Settings" Click="OnGoToSettingsMenuClick"/>
                                            <MenuItem Header="Sign In / Re-Enroll Device" Click="OnOpenEnrollModalClick"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AccentPrimary}">
                                        <TextBlock x:Name="ProfileInitialsText" Text="WI" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Button>

                                <Button Content="&#xE921;" Style="{StaticResource CaptionBtnStyle}" Click="OnMinimizeWindowClick" ToolTip="Minimize"/>
                                <Button Content="&#xE922;" Style="{StaticResource CaptionBtnStyle}" Click="OnMaximizeRestoreClick" ToolTip="Maximize / Restore"/>
                                <Button Content="&#xE8BB;" Style="{StaticResource CaptionBtnStyle}" Click="OnCloseToTrayClick" ToolTip="Minimize to Tray"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- WORKSPACE -->
                    <Grid Grid.Row="1" Margin="28,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- PAGE HEADER -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock x:Name="PageTitleText" Text="Overview" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="PageSubtitleText" Text="Agent status, connection, and live activity" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <WrapPanel x:Name="HeaderActionsWrap" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button x:Name="HeaderToggleAgentBtn" Style="{StaticResource PrimaryBtnStyle}" Click="OnToggleAgentClick" Margin="0,3,8,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="HeaderAgentIcon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="10.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="HeaderAgentLabel" Text="Start Agent" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="HeaderPauseBtn" Style="{StaticResource BtnStyle}" Click="OnTogglePauseClick" IsEnabled="False" Margin="0,3,8,3">
                                    <TextBlock x:Name="HeaderPauseLabel" Text="Pause"/>
                                </Button>
                                <Button Content="Ping" Style="{StaticResource BtnStyle}" Click="OnPingClick" Margin="0,3,8,3"/>
                                <Button Content="Enroll" Style="{StaticResource BtnStyle}" Click="OnOpenEnrollModalClick" Margin="0,3,8,3"/>
                                <Button Content="Dashboard" Style="{StaticResource BtnStyle}" Click="OnOpenDashboardClick" Margin="0,3,0,3"/>
                            </WrapPanel>
                        </Grid>

                        <!-- TAB VIEWS -->
                        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
                            <TabControl.ItemContainerStyle>
                                <Style TargetType="TabItem">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Style>
                            </TabControl.ItemContainerStyle>

                            <!-- VIEW 1: OVERVIEW -->
                            <TabItem Header="Overview">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*" MinHeight="240"/>
                                        </Grid.RowDefinitions>

                                        <!-- 4 Minimal KPI Cards -->
                                        <UniformGrid x:Name="OverviewKpiGrid" Grid.Row="0" Columns="4" Margin="-7,0,-7,10">
                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="7" Cursor="Hand" MouseLeftButtonUp="OnCardGoToSettings">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource BadgeBlueBg}" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BadgeBlueFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="CONNECTION" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock x:Name="KpiStatusText" Text="Disconnected" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                            <Ellipse x:Name="KpiStatusDot" Width="7" Height="7" Fill="#94A3B8" VerticalAlignment="Center" Margin="7,1,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Text="HTTP · WS Side-Channel" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </Grid>
                                            </Border>

                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="7" Cursor="Hand" MouseLeftButtonUp="OnCardGoToTasks">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource BadgePurpleBg}" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BadgePurpleFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="TASKS RECORDED" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                                        <TextBlock x:Name="KpiTasksText" Text="0" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                                                        <TextBlock Text="Local persisted history" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </Grid>
                                            </Border>

                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource BadgeGreenBg}" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BadgeGreenFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="SERVER LATENCY" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                                        <TextBlock x:Name="KpiLatencyText" Text="-- ms" FontSize="17" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{DynamicResource SuccessText}" Margin="0,2,0,0"/>
                                                        <TextBlock Text="Control plane /health" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="7" Cursor="Hand" MouseLeftButtonUp="OnCardGoToSecurity">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource BadgeIndigoBg}" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BadgeIndigoFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="TOKEN VAULT" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                                        <TextBlock Text="DPAPI Sealed" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource IndigoText}" Margin="0,2,0,0"/>
                                                        <TextBlock Text="User-scoped CryptProtect" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </UniformGrid>

                                        <!-- Middle Row (7:5) -->
                                        <Grid x:Name="OverviewMiddleGrid" Grid.Row="1" Margin="0,0,0,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="7*"/>
                                                <ColumnDefinition x:Name="OverviewCpuCol" Width="5*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border x:Name="EndpointCard" Grid.Row="0" Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,14,0">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource BadgeBlueBg}" Margin="0,0,8,0">
                                                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource BadgeBlueFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Text="Endpoint &amp; Credential Controls" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="OverviewEndpointText" Text="https://ec2-77-114-76-12.us-east-2.compute.amazonaws.com" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <Button Content="Rotate Token" Style="{StaticResource BtnStyle}" Click="OnRotateTokenClick" Margin="0,2,8,2"/>
                                                        <Button Content="Sync Policy" Style="{StaticResource BtnStyle}" Click="OnSyncPolicyClick" Margin="0,2,0,2"/>
                                                    </WrapPanel>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="CpuTelemetryCard" Grid.Row="0" Grid.Column="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16">
                                                <DockPanel>
                                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource BadgePurpleBg}" Margin="0,0,8,0">
                                                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource BadgePurpleFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Text="LIVE CPU TELEMETRY (60s)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" x:Name="OverviewCpuLiveText" Text="0.0%" FontSize="12" FontWeight="Medium" FontFamily="Consolas" Foreground="{DynamicResource SuccessText}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <Canvas x:Name="OverviewCpuSparkCanvas" Height="44" ClipToBounds="True">
                                                        <Polygon x:Name="OverviewCpuSparkFill" Fill="#2A6366F1"/>
                                                        <Polyline x:Name="OverviewCpuSparkLine" Stroke="#6366F1" StrokeThickness="1.75" StrokeLineJoin="Round"/>
                                                    </Canvas>
                                                </DockPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Terminal Card (#06080D) -->
                                        <Border Grid.Row="2" Background="{DynamicResource ConsoleCardBg}" BorderBrush="#1A1E2B" BorderThickness="1" CornerRadius="12" Padding="16">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Top" BorderBrush="#161B28" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                                                                <Ellipse Width="6" Height="6" Fill="#34D399" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <TextBlock Text="Live Activity" FontSize="12" FontWeight="Medium" Foreground="#CBD5E1"/>
                                                            </StackPanel>
                                                            <Button x:Name="LogFilterAllBtn" Content="All" Style="{StaticResource TerminalChipActiveStyle}" Click="OnLogFilterClick" Tag="ALL" Margin="0,2,4,2"/>
                                                            <Button x:Name="LogFilterInfoBtn" Content="Info" Style="{StaticResource TerminalChipStyle}" Click="OnLogFilterClick" Tag="INFO" Margin="0,2,4,2"/>
                                                            <Button x:Name="LogFilterWarnBtn" Content="Warn" Style="{StaticResource TerminalChipStyle}" Click="OnLogFilterClick" Tag="WARN" Margin="0,2,4,2"/>
                                                            <Button x:Name="LogFilterErrBtn" Content="Error" Style="{StaticResource TerminalChipStyle}" Click="OnLogFilterClick" Tag="ERR" Margin="0,2,4,2"/>
                                                            <Button Content="Copy" Style="{StaticResource TerminalChipStyle}" Click="OnCopySelectedLogBtnClick" ToolTip="Copy selected (or latest) log entry" Margin="0,2,4,2"/>
                                                            <Button Content="Export" Style="{StaticResource TerminalChipStyle}" Click="OnExportLogClick" Margin="0,2,4,2"/>
                                                            <Button Content="Clear" Style="{StaticResource TerminalChipStyle}" Click="OnClearLogClick" Margin="0,2,8,2"/>
                                                            <TextBox x:Name="LogSearchBox" Width="150" Height="26" Padding="8,3" FontSize="11.5"
                                                                     Background="#0D1220" Foreground="#E2E8F0" CaretBrush="#E2E8F0"
                                                                     BorderBrush="#252C3F" BorderThickness="1" VerticalContentAlignment="Center"
                                                                     Tag="Filter logs..." TextChanged="OnLogSearchChanged" Margin="0,2,4,2">
                                                                <TextBox.Template>
                                                                    <ControlTemplate TargetType="TextBox">
                                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                                                            <Grid Margin="8,2">
                                                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                                                <TextBlock x:Name="Watermark" Text="{TemplateBinding Tag}" Foreground="#64748B" FontSize="11.5" IsHitTestVisible="False" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                                            </Grid>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="Text" Value="">
                                                                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </TextBox.Template>
                                                            </TextBox>
                                                        </WrapPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Auto-scroll" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <CheckBox x:Name="LogAutoScrollChk" IsChecked="True" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <Button x:Name="ExpandConsoleBtn" Content="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                    Style="{StaticResource TerminalChipStyle}" Click="OnToggleExpandConsoleClick"
                                                                    ToolTip="Expand / Collapse Console"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <ListBox x:Name="ActivityLogList" Background="Transparent" BorderThickness="0"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         MouseDoubleClick="OnCopySelectedLogEntry">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Padding" Value="2,2"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Timestamp, StringFormat='[{0}] '}" FontFamily="Consolas" FontSize="12" Foreground="#64748B"/>
                                                                <TextBlock Text="{Binding Level, StringFormat='[{0}] '}" FontFamily="Consolas" FontSize="12" FontWeight="Medium" Foreground="{Binding LevelColor}"/>
                                                                <TextBlock Text="{Binding Message}" FontFamily="Consolas" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>

                            <!-- VIEW 2: TASK EXPLORER -->
                            <TabItem Header="Tasks">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="195"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                            <Button x:Name="TaskFilterAllBtn" Content="All" Style="{StaticResource ChipActiveStyle}" Click="OnTaskFilterClick" Tag="all" Margin="0,2,4,2"/>
                                            <Button x:Name="TaskFilterSuccBtn" Content="Succeeded" Style="{StaticResource ChipBtnStyle}" Click="OnTaskFilterClick" Tag="succeeded" Margin="0,2,4,2"/>
                                            <Button x:Name="TaskFilterFailBtn" Content="Failed" Style="{StaticResource ChipBtnStyle}" Click="OnTaskFilterClick" Tag="failed" Margin="0,2,4,2"/>
                                            <Button x:Name="TaskFilterCancBtn" Content="Cancelled" Style="{StaticResource ChipBtnStyle}" Click="OnTaskFilterClick" Tag="cancelled" Margin="0,2,0,2"/>
                                        </WrapPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox x:Name="TaskSearchBox" Width="280" Style="{StaticResource FieldStyle}" Tag="Filter by task ID or tool..." TextChanged="OnTaskSearchChanged" Margin="0,0,8,0"/>
                                            <Button Content="Clear" Style="{StaticResource BtnStyle}" Click="OnClearTasksClick"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="0">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="0,1,0,0" Padding="14,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TaskPageInfoText" Grid.Column="0" Text="0 tasks · Page 1 of 1" FontSize="11.5" FontFamily="Consolas" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button x:Name="TaskPrevBtn" Content="Prev" Style="{StaticResource BtnStyle}" Padding="10,4" FontSize="11.5" Click="OnTaskPrevPageClick" Margin="0,0,6,0"/>
                                                        <Button x:Name="TaskNextBtn" Content="Next" Style="{StaticResource BtnStyle}" Padding="10,4" FontSize="11.5" Click="OnTaskNextPageClick"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Grid>
                                                <DataGrid x:Name="TasksGrid" Style="{StaticResource MinimalDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="OnTaskSelected">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Task ID" Binding="{Binding Id}" Width="155" FontFamily="Consolas"/>
                                                    <DataGridTextColumn Header="Tool" Binding="{Binding Tool}" Width="*"/>
                                                    <DataGridTemplateColumn Header="Status" Width="130">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                        <Ellipse.Style>
                                                                            <Style TargetType="Ellipse">
                                                                                <Setter Property="Fill" Value="{DynamicResource TextSecondary}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Status}" Value="succeeded">
                                                                                        <Setter Property="Fill" Value="{DynamicResource SuccessText}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Status}" Value="completed">
                                                                                        <Setter Property="Fill" Value="{DynamicResource SuccessText}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Status}" Value="failed">
                                                                                        <Setter Property="Fill" Value="{DynamicResource ErrorText}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Status}" Value="cancelled">
                                                                                        <Setter Property="Fill" Value="{DynamicResource WarningText}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Status}" Value="denied">
                                                                                        <Setter Property="Fill" Value="{DynamicResource ErrorText}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Ellipse.Style>
                                                                    </Ellipse>
                                                                    <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Medium">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Status}" Value="succeeded">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessText}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Status}" Value="completed">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessText}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Status}" Value="failed">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorText}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Status}" Value="cancelled">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningText}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Status}" Value="denied">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorText}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationMs, StringFormat='{}{0} ms'}" Width="105" FontFamily="Consolas"/>
                                                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="170" FontFamily="Consolas"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock x:Name="TasksEmptyState" Visibility="Collapsed" Text="No tasks match the current filter"
                                                       FontSize="12.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DockPanel>
                                    </Border>

                                    <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,14,0,0">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Payload &amp; Result Inspector" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="Open Drawer" Style="{StaticResource BtnStyle}" Padding="10,4" FontSize="12" Click="OnOpenTaskDrawerClick" Margin="0,0,6,0"/>
                                                    <Button Content="Copy JSON" Style="{StaticResource BtnStyle}" Padding="10,4" FontSize="12" Click="OnCopyTaskPayloadClick"/>
                                                </StackPanel>
                                            </Grid>
                                            <Border Background="{DynamicResource ConsoleCardBg}" BorderBrush="#1A1E2B" BorderThickness="1" CornerRadius="10" Padding="12">
                                                <TextBox x:Name="TaskInspectorBox" Background="Transparent" Foreground="#CBD5E1"
                                                         BorderThickness="0" FontFamily="Consolas" FontSize="12"
                                                         Text="Select a task row above to inspect payload and result details."
                                                         IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                            </Border>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- VIEW 3: SYSTEM MONITOR -->
                            <TabItem Header="Monitor">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*" MinHeight="250"/>
                                        </Grid.RowDefinitions>

                                        <UniformGrid x:Name="MonitorSparkGrid" Grid.Row="0" Columns="2" Margin="-7,0,-7,8">
                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="7">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="CPU Utilization (60s)" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}"/>
                                                        <TextBlock Grid.Column="1" x:Name="MonCpuText" Text="0.0%" FontSize="16" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{DynamicResource IndigoText}"/>
                                                    </Grid>
                                                    <Canvas x:Name="MonCpuSparkCanvas" Height="68" ClipToBounds="True">
                                                        <Polygon x:Name="MonCpuSparkFill" Fill="#2A6366F1"/>
                                                        <Polyline x:Name="MonCpuSparkLine" Stroke="#6366F1" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                                                    </Canvas>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="7">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Memory Usage (60s)" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}"/>
                                                        <TextBlock Grid.Column="1" x:Name="MonMemText" Text="0 / 0 GB" FontSize="16" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{DynamicResource SuccessText}"/>
                                                    </Grid>
                                                    <Canvas x:Name="MonMemSparkCanvas" Height="68" ClipToBounds="True">
                                                        <Polygon x:Name="MonMemSparkFill" Fill="#2610B981"/>
                                                        <Polyline x:Name="MonMemSparkLine" Stroke="#10B981" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                                                    </Canvas>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <UniformGrid x:Name="MonitorStatsGrid" Grid.Row="1" Columns="3" Margin="-7,0,-7,8">
                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="7">
                                                <StackPanel>
                                                    <TextBlock Text="System Disk" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="MonDiskText" Text="0 / 0 GB" FontSize="14" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                                    <ProgressBar x:Name="MonDiskBar" Height="6" Maximum="100" Foreground="#F59E0B" Background="{DynamicResource BgElevated}" BorderThickness="0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="7">
                                                <StackPanel>
                                                    <TextBlock Text="Network &amp; Processes" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="MonNetText" Text="0 KB/s ↓ · 0 KB/s ↑" FontSize="14" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}"/>
                                                    <TextBlock x:Name="MonProcText" Text="0 processes · 0h 0m uptime" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="7">
                                                <StackPanel>
                                                    <TextBlock Text="GPU &amp; Hardware" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="MonGpuText" Text="Detecting GPU..." FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="MonCpuModelText" Text="CPU..." FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                                    <TextBlock x:Name="MonPipeStatusText" Text="C++ Desktop Pipe: Offline" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16">
                                            <DockPanel>
                                                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="Process Manager" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        <TextBox x:Name="ProcSearchBox" Width="210" Style="{StaticResource FieldStyle}" Tag="Filter processes..." TextChanged="OnProcSearchChanged"/>
                                                    </WrapPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Content="Refresh" Style="{StaticResource BtnStyle}" Padding="10,5" FontSize="12" Click="OnRefreshProcessesClick" Margin="0,0,6,0"/>
                                                        <Button Content="End Process" Style="{StaticResource DangerBtnStyle}" Padding="10,5" FontSize="12" Click="OnKillProcessClick"/>
                                                    </StackPanel>
                                                </Grid>
                                                <DataGrid x:Name="ProcessesGrid" Style="{StaticResource MinimalDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="90" FontFamily="Consolas"/>
                                                        <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*"/>
                                                        <DataGridTextColumn Header="Memory (MB)" Binding="{Binding MemoryMb}" Width="120" FontFamily="Consolas"/>
                                                        <DataGridTextColumn Header="Threads" Binding="{Binding Threads}" Width="90" FontFamily="Consolas"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>

                            <!-- VIEW 4: DESKTOP VISION -->
                            <TabItem Header="Vision">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                                <ComboBox x:Name="VisionMonitorCombo" Style="{StaticResource SaaSComboBoxStyle}" Width="210" Margin="0,2,8,2" DisplayMemberPath="DisplayLabel"/>
                                                <Button Content="Capture" Style="{StaticResource PrimaryBtnStyle}" Padding="12,6" FontSize="12" Click="OnCaptureScreenshotClick" Margin="0,2,8,2"/>
                                                <Button Content="Full Desktop" Style="{StaticResource BtnStyle}" Padding="12,6" FontSize="12" Click="OnCaptureFullDesktopClick" Margin="0,2,8,2"/>
                                                <Button Content="C++ H.264 Probe" Style="{StaticResource BtnStyle}" Padding="12,6" FontSize="12" Click="OnVisionCppProbeClick" Margin="0,2,8,2" ToolTip="Capture frame via C++20 DXGI and encode H.264 keyframe via Media Foundation"/>
                                                <Button x:Name="VisionWebRtcBtn" Content="Start H.264 Stream" Style="{StaticResource BtnStyle}" Padding="12,6" FontSize="12" Click="OnVisionToggleWebRtcClick" Margin="0,2,8,2" ToolTip="Start or stop real-time C++20 DXGI + Media Foundation H.264 WebRTC streaming agent"/>
                                                <Button Content="Reset DXGI" Style="{StaticResource BtnStyle}" Padding="12,6" FontSize="12" Click="OnVisionResetDxgiClick" Margin="0,2,8,2" ToolTip="Reinitialize C++ DXGI Desktop Duplication output"/>
                                                <Button x:Name="VisionZoomBtn" Content="Zoom: Fit" Style="{StaticResource BtnStyle}" Padding="12,6" FontSize="12" Click="OnVisionZoomToggleClick" Margin="0,2,8,2"/>
                                                <Button Content="Open" Style="{StaticResource BtnStyle}" Padding="12,6" FontSize="12" Click="OnOpenScreenshotClick" Margin="0,2,8,2"/>
                                                <Button Content="Copy Path" Style="{StaticResource BtnStyle}" Padding="12,6" FontSize="12" Click="OnCopyScreenshotPathClick" Margin="0,2,8,2"/>
                                                <Button Content="Open Folder" Style="{StaticResource BtnStyle}" Padding="12,6" FontSize="12" Click="OnOpenScreenshotsFolderClick" Margin="0,2,0,2"/>
                                            </WrapPanel>
                                            <TextBlock x:Name="VisionMetaText" Grid.Column="1" Text="Ready" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="9*"/>
                                            <ColumnDefinition x:Name="VisionHistoryCol" Width="3*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,14,0">
                                            <Grid>
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                    <Image x:Name="VisionPreviewImage" Stretch="Uniform"/>
                                                </ScrollViewer>
                                                <StackPanel x:Name="VisionEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock Text="Click Capture to inspect your desktop session" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Hardware C++20 DXGI Desktop Duplication &amp; Media Foundation H.264 with GDI fallback" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border x:Name="VisionHistoryCard" Grid.Column="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                                    <TextBlock Text="Display Topology" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                                    <TextBlock x:Name="VisionDisplayInfoText" Text="Detecting displays..." FontSize="11.5" FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                                    <Border Height="1" Background="{DynamicResource BorderHairline}" Margin="0,0,0,10"/>
                                                    <TextBlock Text="C++20 DXGI &amp; H.264 Telemetry" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                                    <TextBlock x:Name="VisionCppMetricsText" Text="Engine: ai_bridge_native.dll ready" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource IndigoText}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                                    <Border Height="1" Background="{DynamicResource BorderHairline}" Margin="0,0,0,10"/>
                                                    <TextBlock Text="Capture History" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}"/>
                                                </StackPanel>
                                                <Grid>
                                                    <ListBox x:Name="CaptureHistoryList" Background="Transparent" BorderThickness="0"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             SelectionChanged="OnCaptureHistorySelected">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Resolution}" FontFamily="Consolas" FontSize="11.5"
                                                                           Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,3"/>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <TextBlock x:Name="CaptureHistoryEmptyText" Text="No captures yet" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </TabItem>

                            <!-- VIEW 5: SECURITY & POLICY -->
                            <TabItem Header="Security">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <UniformGrid x:Name="SecurityPostureGrid" Columns="4" Margin="-7,0,-7,8">
                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="7">
                                                <StackPanel>
                                                    <TextBlock Text="Token Vault" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                                    <TextBlock Text="DPAPI Active" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SuccessText}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="7">
                                                <StackPanel>
                                                    <TextBlock Text="Execution Mode" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                                    <TextBlock x:Name="SecModeSummaryText" Text="4-Tier Enforced" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="7">
                                                <StackPanel>
                                                    <TextBlock Text="Local Prompt" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                                    <TextBlock x:Name="SecLocalApprovalText" Text="Off" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="7">
                                                <StackPanel>
                                                    <TextBlock Text="Allowed Apps" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                                    <TextBlock x:Name="SecAllowedCountText" Text="5 apps" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Four-Tier Execution Guardrails" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                    <WrapPanel Grid.Column="1">
                                                        <Button Content="Full Desktop" Style="{StaticResource BtnStyle}" Padding="10,4.5" FontSize="12" Click="OnPresetFullClick" Margin="0,2,6,2"/>
                                                        <Button Content="Workstation" Style="{StaticResource BtnStyle}" Padding="10,4.5" FontSize="12" Click="OnPresetWorkstationClick" Margin="0,2,6,2"/>
                                                        <Button Content="Lockdown" Style="{StaticResource DangerBtnStyle}" Padding="10,4.5" FontSize="12" Click="OnPresetLockdownClick" Margin="0,2,0,2"/>
                                                    </WrapPanel>
                                                </Grid>

                                                <CheckBox x:Name="PolAllowWritesChk" Style="{StaticResource ToggleSwitchStyle}" Content="Allow Tier 2: Workspace file writes &amp; project tests"/>
                                                <CheckBox x:Name="PolAllowTier3Chk" Style="{StaticResource ToggleSwitchStyle}" Content="Allow Tier 3: Sensitive operations (screenshots, edits, backups)"/>
                                                <CheckBox x:Name="PolAllowTier4Chk" Style="{StaticResource ToggleSwitchStyle}" Content="Allow Tier 4: High-risk operations (requires explicit human approval)"/>
                                                <CheckBox x:Name="PolAllowShellChk" Style="{StaticResource ToggleSwitchStyle}" Content="Allow Shell Execution (run_shell)"/>
                                                <CheckBox x:Name="PolAllowDesktopChk" Style="{StaticResource ToggleSwitchStyle}" Content="Allow Interactive Desktop Input (SendInput &amp; UI Automation)"/>
                                                <CheckBox x:Name="PolAllowPackageInstallChk" Style="{StaticResource ToggleSwitchStyle}" Content="Allow Package Installation (install_package)"/>
                                                <CheckBox x:Name="PolAllowClipboardChk" Style="{StaticResource ToggleSwitchStyle}" Content="Allow Clipboard Synchronization (get_clipboard / set_clipboard)"/>
                                                <CheckBox x:Name="PolAllowFullPcChk" Style="{StaticResource ToggleSwitchStyle}" Content="Allow Full PC Access (all drives &amp; files, PowerShell, processes &amp; unrestricted apps)"/>
                                                <CheckBox x:Name="PolRequireLocalApprovalChk" Style="{StaticResource ToggleSwitchStyle}" Content="Require local workstation approval popup for Tier 3/4 tasks"/>

                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Unattended Max Risk Tier:" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <ComboBox x:Name="PolMaxTierCombo" Style="{StaticResource SaaSComboBoxStyle}" Width="240" SelectedIndex="2">
                                                        <ComboBoxItem Content="Tier 1 — Read-Only" Tag="1"/>
                                                        <ComboBoxItem Content="Tier 2 — Low-Risk Workspace Writes" Tag="2"/>
                                                        <ComboBoxItem Content="Tier 3 — Sensitive Desktop &amp; Edits" Tag="3"/>
                                                        <ComboBoxItem Content="Tier 4 — High-Risk &amp; Shell" Tag="4"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <WrapPanel Margin="0,14,0,0">
                                                    <Button Content="Save Local Policy" Style="{StaticResource PrimaryBtnStyle}" Click="OnSavePolicyClick" Margin="0,4,8,4"/>
                                                    <Button Content="Sync to Server" Style="{StaticResource BtnStyle}" Click="OnSyncPolicyClick" Margin="0,4,8,4"/>
                                                    <Button Content="Fetch from Server" Style="{StaticResource BtnStyle}" Click="OnFetchPolicyClick" Margin="0,4,0,4"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <UniformGrid x:Name="SecurityBottomGrid" Columns="3" Margin="-7,0,-7,0">
                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="7">
                                                <StackPanel>
                                                    <TextBlock Text="Allowed Application Matrix" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="NewAppBox" Style="{StaticResource FieldStyle}" Tag="Add executable (e.g. code.exe)" Margin="0,0,8,0"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button Content="Add" Style="{StaticResource BtnStyle}" Padding="10,6" FontSize="12" Click="OnAddAllowedAppClick" Margin="0,0,6,0"/>
                                                            <Button Content="Remove" Style="{StaticResource DangerBtnStyle}" Padding="10,6" FontSize="12" Click="OnRemoveAllowedAppClick"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <ListBox x:Name="AllowedAppsList" Height="150" Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}"
                                                             BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" FontFamily="Consolas" FontSize="12" Padding="8"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="7">
                                                <StackPanel>
                                                    <TextBlock Text="Allowed Shell Commands (empty = all)" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="NewCommandBox" Style="{StaticResource FieldStyle}" Tag="Add command (e.g. git)" Margin="0,0,8,0"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button Content="Add" Style="{StaticResource BtnStyle}" Padding="10,6" FontSize="12" Click="OnAddAllowedCommandClick" Margin="0,0,6,0"/>
                                                            <Button Content="Remove" Style="{StaticResource DangerBtnStyle}" Padding="10,6" FontSize="12" Click="OnRemoveAllowedCommandClick"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <ListBox x:Name="AllowedCommandsList" Height="150" Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}"
                                                             BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" FontFamily="Consolas" FontSize="12" Padding="8"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="7">
                                                <StackPanel>
                                                    <TextBlock Text="Policy Activity Timeline" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>
                                                    <ListBox x:Name="PolicyAuditList" Height="195" Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextSecondary}"
                                                             BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" FontFamily="Consolas" FontSize="11.5" Padding="8"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,3">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="16"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentPrimary}" Margin="0,4,0,2"/>
                                                                        <Rectangle Width="1" Height="14" Fill="{DynamicResource BorderHairline}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <!-- Collapsible Guardrails FAQ Accordion (#20) -->
                                        <StackPanel Margin="0,14,0,0">
                                            <TextBlock Text="SECURITY ARCHITECTURE &amp; GUARDRAILS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="2,0,0,8"/>
                                            <Expander Style="{StaticResource SaaSExpanderStyle}" Header="How does Windows DPAPI sealing protect device tokens?" IsExpanded="True">
                                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                                           Text="Tokens and optional named-pipe HMAC keys are sealed using Win32 CryptProtectData scoped strictly to your current Windows user session, preventing plaintext disk exposure."/>
                                            </Expander>
                                            <Expander Style="{StaticResource SaaSExpanderStyle}" Header="Why does AI Bridge use an outbound-only poller &amp; WebSocket side-channel?">
                                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                                           Text="Outbound TLS long-polling with an optional WebSocket wake channel avoids opening inbound firewall ports while preserving instant cancellation and Emergency All-Stop."/>
                                            </Expander>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- VIEW 6: SETTINGS -->
                            <TabItem Header="Settings">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Category Filter & Save Bar -->
                                    <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                                <Button x:Name="SetCatAllBtn" Content="All" Style="{StaticResource ChipActiveStyle}" Click="OnSettingsCategoryClick" Tag="ALL" Margin="0,2,4,2"/>
                                                <Button x:Name="SetCatGenBtn" Content="General" Style="{StaticResource ChipBtnStyle}" Click="OnSettingsCategoryClick" Tag="GENERAL" Margin="0,2,4,2"/>
                                                <Button x:Name="SetCatCpBtn" Content="Control Plane" Style="{StaticResource ChipBtnStyle}" Click="OnSettingsCategoryClick" Tag="CONTROL_PLANE" Margin="0,2,4,2"/>
                                                <Button x:Name="SetCatAgentBtn" Content="Agent" Style="{StaticResource ChipBtnStyle}" Click="OnSettingsCategoryClick" Tag="AGENT" Margin="0,2,4,2"/>
                                                <Button x:Name="SetCatCppBtn" Content="C++ Engine" Style="{StaticResource ChipBtnStyle}" Click="OnSettingsCategoryClick" Tag="CPP_AGENT" Margin="0,2,4,2"/>
                                                <Button x:Name="SetCatLogBtn" Content="Logging" Style="{StaticResource ChipBtnStyle}" Click="OnSettingsCategoryClick" Tag="LOGGING" Margin="0,2,4,2"/>
                                                <Button x:Name="SetCatSecBtn" Content="Security" Style="{StaticResource ChipBtnStyle}" Click="OnSettingsCategoryClick" Tag="SECURITY" Margin="0,2,4,2"/>
                                                <Button x:Name="SetCatAppBtn" Content="Appearance" Style="{StaticResource ChipBtnStyle}" Click="OnSettingsCategoryClick" Tag="APPEARANCE" Margin="0,2,4,2"/>
                                                <Button x:Name="SetCatAdvBtn" Content="Advanced" Style="{StaticResource ChipBtnStyle}" Click="OnSettingsCategoryClick" Tag="ADVANCED" Margin="0,2,0,2"/>
                                            </WrapPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <Button Content="Reset Defaults" Style="{StaticResource BtnStyle}" Padding="10,6" FontSize="12" Click="OnResetSettingsClick" Margin="0,0,8,0"/>
                                                <Button Content="Save Configuration" Style="{StaticResource PrimaryBtnStyle}" Padding="14,6" FontSize="12" Click="OnSaveSettingsClick"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <!-- GENERAL -->
                                            <Border x:Name="SetSectionGeneral" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="General &amp; Windows Integration" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                                                    <TextBlock Text="Workspace Confinement Directory" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="SetWorkspaceBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                                        <Button Grid.Column="1" Content="Browse..." Style="{StaticResource BtnStyle}" Click="OnBrowseWorkspaceClick" Margin="8,0,0,0"/>
                                                    </Grid>

                                                    <TextBlock Text="Screenshot Storage Directory" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                    <Grid Margin="0,0,0,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="SetScreenshotDirBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                                        <Button Grid.Column="1" Content="Browse..." Style="{StaticResource BtnStyle}" Click="OnBrowseScreenshotDirClick" Margin="8,0,0,0"/>
                                                    </Grid>

                                                    <TextBlock Text="Workstation Tags (press Enter to add)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                    <WrapPanel Margin="0,0,0,14" VerticalAlignment="Center">
                                                        <ItemsControl x:Name="SetTagsItems">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel VerticalAlignment="Center"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource BorderHairline}"
                                                                            BorderThickness="1" CornerRadius="12" Padding="9,4" Margin="0,2,6,2">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding}" FontSize="11.5" FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                                            <Button Content="×" Margin="6,0,0,0" Padding="2,0" FontSize="12" Background="Transparent" BorderThickness="0"
                                                                                    Foreground="{DynamicResource TextMuted}" Cursor="Hand" Click="OnRemoveTagClick" Tag="{Binding}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBox x:Name="NewTagBox" Width="150" Style="{StaticResource FieldStyle}" Padding="8,5" FontSize="11.5"
                                                                 Tag="Add tag + Enter..." PreviewKeyDown="OnNewTagKeyDown" Margin="0,2,0,2"/>
                                                    </WrapPanel>

                                                    <CheckBox x:Name="SetAutoStartChk" Style="{StaticResource ToggleSwitchStyle}" Content="Launch automatically when Windows starts (HKCU Run)"/>
                                                    <CheckBox x:Name="SetMinimizeToTrayChk" Style="{StaticResource ToggleSwitchStyle}" Content="Minimize to system tray instead of exiting on close" Margin="0,4,0,0"/>
                                                    <CheckBox x:Name="SetNotificationsChk" Style="{StaticResource ToggleSwitchStyle}" Content="Show Windows tray notifications for tasks &amp; approvals" Margin="0,4,0,0"/>
                                                    <CheckBox x:Name="SetConfirmDestructiveChk" Style="{StaticResource ToggleSwitchStyle}" Content="Confirm before ending processes, clearing tasks, or resetting defaults" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- CONTROL PLANE -->
                                            <Border x:Name="SetSectionControlPlane" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Control Plane &amp; Transport" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                        <TextBlock Grid.Column="1" x:Name="SetValidationBadge" Text="" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource SuccessText}"/>
                                                    </Grid>

                                                    <TextBlock Text="Control Plane URL" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="SetControlUrlBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                                        <Button Grid.Column="1" Content="Test Connection" Style="{StaticResource BtnStyle}" Click="OnTestConnectionClick" Margin="8,0,0,0"/>
                                                    </Grid>

                                                    <UniformGrid Columns="2" Margin="-6,0,-6,12">
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="Device ID" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="SetDeviceIdBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="Tenant ID" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="SetTenantIdBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                    </UniformGrid>

                                                    <UniformGrid Columns="4" Margin="-6,0,-6,14">
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="Long-Poll Wait (5–60s)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="SetPollIntervalBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="Heartbeat (5–120s)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="SetHeartbeatIntervalBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="HTTP Timeout (5–120s)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="SetHttpTimeoutBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="WS Reconnect (3–120s)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="SetWsReconnectBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                    </UniformGrid>

                                                    <CheckBox x:Name="SetAutoConnectChk" Style="{StaticResource ToggleSwitchStyle}" Content="Connect to Control Plane automatically on startup"/>
                                                    <CheckBox x:Name="SetWsEnabledChk" Style="{StaticResource ToggleSwitchStyle}" Content="Enable WebSocket side-channel for instant wake &amp; emergency stop" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- AGENT -->
                                            <Border x:Name="SetSectionAgent" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="Agent Execution Limits &amp; Telemetry" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                                                    <UniformGrid Columns="3" Margin="-6,0,-6,12">
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="Default Tool Timeout (s)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="SetDefaultTimeoutBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="Max Tool Timeout (s)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="SetMaxTimeoutBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="Monitor Poll Interval (ms)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="SetMonitorIntervalBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                    </UniformGrid>

                                                    <UniformGrid Columns="4" Margin="-6,0,-6,14">
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="Max Read Bytes" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="SetMaxReadBytesBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="Max Output Bytes" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="SetMaxOutputBytesBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="Max List Entries" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="SetMaxListEntriesBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="Task History Limit" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="SetTaskHistoryLimitBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                    </UniformGrid>

                                                    <CheckBox x:Name="SetAutoRefreshMonChk" Style="{StaticResource ToggleSwitchStyle}" Content="Auto-refresh System Monitor CPU, Memory, Disk &amp; Network telemetry"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- C++20 NATIVE AGENT, DXGI CAPTURE, MEDIA FOUNDATION H.264 & WEBRTC ENGINE -->
                                            <Border x:Name="SetSectionCppAgent" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="C++20 Native Agent, DXGI Capture, Media Foundation H.264 &amp; WebRTC Engine" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                            <TextBlock Text="Controls ai_bridge_native.dll (in-process P/Invoke), ai_bridge_service.exe (HMAC-SHA256 pipe server), and ai_bridge_desktop.exe (WebRTC/H.264 agent)" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" x:Name="SetCppStatusBadge" Text="C++ DLL &amp; Pipe Active" FontSize="11.5" FontFamily="Consolas" Foreground="{DynamicResource SuccessText}" VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <CheckBox x:Name="SetCppAutoStartChk" Style="{StaticResource ToggleSwitchStyle}" Content="Auto-start C++ Supervisor Named-Pipe Server (ai_bridge_service.exe --pipe-server)"/>
                                                    <CheckBox x:Name="SetCppPreferDxgiChk" Style="{StaticResource ToggleSwitchStyle}" Content="Prefer C++20 DXGI Desktop Duplication GPU capture (automatic GDI fallback on Session-0 / headless)" Margin="0,4,0,0"/>
                                                    <CheckBox x:Name="SetCppPreferHwH264Chk" Style="{StaticResource ToggleSwitchStyle}" Content="Prefer Hardware H.264 Encoder MFT (NVIDIA NVENC / Intel QuickSync / AMD AMF)" Margin="0,4,0,0"/>
                                                    <CheckBox x:Name="SetCppAdaptiveBitrateChk" Style="{StaticResource ToggleSwitchStyle}" Content="Enable Dynamic Adaptive Bitrate (ABR) scaling on WebRTC transport congestion" Margin="0,4,0,0"/>
                                                    <CheckBox x:Name="SetCppCursorHaloChk" Style="{StaticResource ToggleSwitchStyle}" Content="Show glowing cursor halo while AI Agent controls the screen" Margin="0,4,0,10"/>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                                                        <TextBlock Text="Human-Like Input Speed:" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        <ComboBox x:Name="SetCppInputSpeedCombo" Style="{StaticResource SaaSComboBoxStyle}" Width="220" SelectedIndex="1">
                                                            <ComboBoxItem Content="Fast (0.55x — snappy glide)" Tag="fast"/>
                                                            <ComboBoxItem Content="Natural (1.0x — human pace)" Tag="natural"/>
                                                            <ComboBoxItem Content="Careful (1.45x — slow &amp; precise)" Tag="careful"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <UniformGrid Columns="3" Margin="-6,0,-6,12">
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="Target H.264 FPS (1–60)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="SetCppFpsBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas" Text="30"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="Target H.264 Bitrate (250–50000 kbps)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="SetCppBitrateBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas" Text="4500"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="H.264 Keyframe Interval (1–15s)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="SetCppKeyframeBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas" Text="2"/>
                                                        </StackPanel>
                                                    </UniformGrid>

                                                    <UniformGrid Columns="3" Margin="-6,0,-6,14">
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="C++ WebRTC TURN Server URL (optional)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="SetCppTurnUrlBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas" ToolTip="Example: turn:turn.example.com:3478"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="TURN Username" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="SetCppTurnUserBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="TURN Credential / Secret" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <PasswordBox x:Name="SetCppTurnCredBox" Style="{StaticResource PasswordFieldStyle}" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                    </UniformGrid>

                                                    <WrapPanel Margin="0,0,0,10">
                                                        <Button Content="Apply H.264 Bitrate Live" Style="{StaticResource PrimaryBtnStyle}" Padding="10,6" FontSize="11.5" Click="OnCppApplyBitrateClick" Margin="0,2,6,2"/>
                                                        <Button Content="Probe DXGI + H.264" Style="{StaticResource BtnStyle}" Padding="10,6" FontSize="11.5" Click="OnCppProbeEngineClick" Margin="0,2,6,2"/>
                                                        <Button Content="Run C++ Self-Tests (7/7)" Style="{StaticResource BtnStyle}" Padding="10,6" FontSize="11.5" Click="OnCppRunSelfTestsClick" Margin="0,2,6,2"/>
                                                        <Button Content="C++ System Health JSON" Style="{StaticResource BtnStyle}" Padding="10,6" FontSize="11.5" Click="OnCppSystemHealthClick" Margin="0,2,6,2"/>
                                                        <Button Content="Ping Pipe" Style="{StaticResource BtnStyle}" Padding="10,6" FontSize="11.5" Click="OnCppPingPipeClick" Margin="0,2,6,2"/>
                                                        <Button Content="Restart C++ Pipe Server" Style="{StaticResource BtnStyle}" Padding="10,6" FontSize="11.5" Click="OnCppRestartSupervisorClick" Margin="0,2,6,2"/>
                                                        <Button Content="Stop Pipe Server" Style="{StaticResource DangerBtnStyle}" Padding="10,6" FontSize="11.5" Click="OnCppStopSupervisorClick" Margin="0,2,6,2"/>
                                                        <Button Content="Release Held Keys" Style="{StaticResource DangerBtnStyle}" Padding="10,6" FontSize="11.5" Click="OnCppReleaseKeysClick" Margin="0,2,0,2"/>
                                                    </WrapPanel>

                                                    <TextBox x:Name="SetCppConsoleBox" Height="130" Background="{DynamicResource ConsoleCardBg}" Foreground="#CBD5E1"
                                                             BorderThickness="0" FontFamily="Consolas" FontSize="11" IsReadOnly="True" Padding="10"
                                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                             Text="Click 'Probe DXGI + H.264' or 'Run C++ Self-Tests (7/7)' to inspect the native C++20 engine."/>
                                                </StackPanel>
                                            </Border>

                                            <!-- LOGGING -->
                                            <Border x:Name="SetSectionLogging" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="Logging &amp; Activity Console" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                                                    <UniformGrid Columns="3" Margin="-6,0,-6,14">
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="Minimum Log Level" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <ComboBox x:Name="SetLogLevelCombo" Style="{StaticResource SaaSComboBoxStyle}">
                                                                <ComboBoxItem Content="DEBUG" Tag="DEBUG"/>
                                                                <ComboBoxItem Content="INFO" Tag="INFO"/>
                                                                <ComboBoxItem Content="WARN" Tag="WARN"/>
                                                                <ComboBoxItem Content="ERR" Tag="ERR"/>
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="In-Memory Log Buffer" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="SetMaxLogEntriesBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="Max Log File Size (MB)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="SetMaxLogFileMbBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                    </UniformGrid>

                                                    <CheckBox x:Name="SetFileLoggingChk" Style="{StaticResource ToggleSwitchStyle}" Content="Persist rolling client logs to ~/.ai-bridge/logs/ai-bridge-client.log"/>
                                                    <CheckBox x:Name="SetAutoScrollDefaultChk" Style="{StaticResource ToggleSwitchStyle}" Content="Auto-scroll Live Activity Console by default" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- SECURITY -->
                                            <Border x:Name="SetSectionSecurity" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="Security, Token Vault &amp; C++ Pipe IPC" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                                                    <TextBlock Text="Device Token (DPAPI-sealed)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <PasswordBox x:Name="SetTokenPasswordBox" Style="{StaticResource PasswordFieldStyle}" FontFamily="Consolas"/>
                                                        <TextBox x:Name="SetTokenPlainBox" Visibility="Collapsed" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                                            <Button x:Name="ToggleTokenVisBtn" Content="Show" Style="{StaticResource BtnStyle}" Padding="12,6" FontSize="12" Click="OnToggleTokenVisClick" Margin="0,0,6,0"/>
                                                            <Button Content="Copy" Style="{StaticResource BtnStyle}" Padding="12,6" FontSize="12" Click="OnCopyTokenClick" Margin="0,0,6,0"/>
                                                            <Button Content="Reload" Style="{StaticResource BtnStyle}" Padding="12,6" FontSize="12" Click="OnReloadTokenClick" Margin="0,0,6,0"/>
                                                            <Button Content="Enroll..." Style="{StaticResource BtnStyle}" Padding="12,6" FontSize="12" Click="OnOpenEnrollModalClick" Margin="0,0,6,0"/>
                                                            <Button Content="Clear Token" Style="{StaticResource DangerBtnStyle}" Padding="12,6" FontSize="12" Click="OnClearTokenClick"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <UniformGrid Columns="2" Margin="-6,0,-6,0">
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="C++ Desktop Named Pipe Name" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="SetPipeNameBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="Named-Pipe HMAC Secret (optional, DPAPI-sealed)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                            <PasswordBox x:Name="SetPipeHmacSecretBox" Style="{StaticResource PasswordFieldStyle}" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Border>

                                            <!-- APPEARANCE -->
                                            <Border x:Name="SetSectionAppearance" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="Appearance &amp; Workspace Layout" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                                                    <TextBlock Text="Application Theme" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                    <ComboBox x:Name="SetThemeCombo" Style="{StaticResource SaaSComboBoxStyle}" Width="240" HorizontalAlignment="Left" Margin="0,0,0,14">
                                                        <ComboBoxItem Content="Dark Theme" Tag="dark"/>
                                                        <ComboBoxItem Content="Light Theme" Tag="light"/>
                                                        <ComboBoxItem Content="Follow Windows System" Tag="system"/>
                                                    </ComboBox>

                                                    <CheckBox x:Name="SetCompactSidebarChk" Style="{StaticResource ToggleSwitchStyle}" Content="Start with compact icon-only navigation sidebar"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- ADVANCED -->
                                            <Border x:Name="SetSectionAdvanced" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="20">
                                                <StackPanel>
                                                    <TextBlock Text="Advanced, Diagnostics &amp; Updates" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                                                    <TextBlock Text="Custom Update Manifest URL (optional override)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                                    <TextBox x:Name="SetUpdateManifestUrlBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas" Tag="https://.../api/updates/manifest" Margin="0,0,0,12"/>

                                                    <CheckBox x:Name="SetAutoCheckUpdatesChk" Style="{StaticResource ToggleSwitchStyle}" Content="Check for signed releases automatically on startup" Margin="0,0,0,12"/>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" x:Name="SetUpdateStatusText" Text="Current version: v0.3.0" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <Button Content="Copy Diagnostics" Style="{StaticResource BtnStyle}" Click="OnCopyDiagnosticsClick" Margin="0,2,8,2"/>
                                                            <Button Content="Export Bundle (.zip)" Style="{StaticResource BtnStyle}" Click="OnExportDiagnosticsBundleClick" Margin="0,2,8,2"/>
                                                            <Button Content="Open Logs" Style="{StaticResource BtnStyle}" Click="OnOpenLogsFolderClick" Margin="0,2,8,2"/>
                                                            <Button Content="Open Config Dir" Style="{StaticResource BtnStyle}" Click="OnOpenConfigDirClick" Margin="0,2,8,2"/>
                                                            <Button Content="Check Updates" Style="{StaticResource BtnStyle}" Click="OnCheckUpdatesClick" Margin="0,2,0,2"/>
                                                        </WrapPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>

                            <!-- VIEW 7: AGENTS (ChatGPT-Style Interface Scoped to This Windows Device) -->
                            <TabItem Header="Agents">
                                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="AgLeftRailCol" Width="228"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition x:Name="AgDrawerCol" Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- LEFT CHATGPT CONVERSATION SIDEBAR -->
                                        <Border Grid.Column="0" Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="0,0,1,0" Padding="12">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                                    <Button Content="+ New Chat" Style="{StaticResource PrimaryBtnStyle}" Padding="12,8" FontSize="12.5" Click="OnAgNewChatClick" Margin="0,0,0,10"/>
                                                    <Border Background="{DynamicResource NavActiveBg}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="8" Padding="9,6">
                                                        <StackPanel>
                                                            <TextBlock Text="INSTALLED DEVICE ONLY" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                                            <TextBlock x:Name="AgScopedDeviceBadgeText" Text="Scoped to: windows" FontSize="11.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource IndigoText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Bottom Runtime & Settings Triggers -->
                                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <TextBlock x:Name="AgPollerStateText" Text="Worker: Stopped" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                                            <TextBlock x:Name="AgPipeStateText" Text="Desktop Pipe: Not Running" FontSize="11" Foreground="{DynamicResource WarningText}" Margin="0,2,0,0"/>
                                                            <TextBlock x:Name="AgPollerMetaText" Text="Local tools ready" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Button x:Name="AgToggleDrawerBtn" Content="Agent Settings &amp; Runtime" Style="{StaticResource BtnStyle}" Padding="10,7" FontSize="11.5" Click="OnAgOpenSettingsDrawerClick"/>
                                                </StackPanel>

                                                <!-- Thread History List -->
                                                <StackPanel>
                                                    <Grid Margin="4,4,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="CONVERSATIONS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button Content="Export" Style="{StaticResource GhostBtnStyle}" Padding="5,1" FontSize="10" Click="OnAgExportThreadClick" ToolTip="Export active conversation to Markdown (.md)"/>
                                                            <Button Content="Del" Style="{StaticResource GhostBtnStyle}" Padding="5,1" FontSize="10" Click="OnAgDeleteThreadClick" ToolTip="Delete active conversation"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBox x:Name="AgThreadSearchBox" Style="{StaticResource FieldStyle}" Padding="8,5" FontSize="11" Tag="Search chats..." TextChanged="OnAgThreadSearchChanged" Margin="0,0,0,6"/>
                                                    <ListBox x:Name="AgThreadsList" Background="Transparent" BorderThickness="0" SelectionChanged="OnAgThreadSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="8,7" Margin="0,0,0,2" CornerRadius="8">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding Preview}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- CENTER MAIN CHATGPT STREAM & COMPOSER -->
                                        <Grid Grid.Column="1" Background="{DynamicResource BgCard}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" MinHeight="48"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Top Model / Mode Bar (wraps cleanly so controls never clip) -->
                                            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="0,0,0,1" Padding="14,8">
                                                <WrapPanel VerticalAlignment="Center" ItemHeight="30">
                                                    <ComboBox x:Name="AgChatModeCombo" Style="{StaticResource SaaSComboBoxStyle}" Width="210" SelectedIndex="0" FontSize="11.5" Margin="0,2,8,2">
                                                        <ComboBoxItem Content="AI Bridge Copilot (Auto + Local)" Tag="auto"/>
                                                        <ComboBoxItem Content="OpenAI · GPT-4o (This Device)" Tag="openai"/>
                                                        <ComboBoxItem Content="Anthropic · Claude (This Device)" Tag="anthropic"/>
                                                        <ComboBoxItem Content="Google · Gemini (This Device)" Tag="gemini"/>
                                                        <ComboBoxItem Content="Local Windows Tools Only (Offline)" Tag="local"/>
                                                    </ComboBox>
                                                    <Button x:Name="AgFullPcBtn" Content="Full PC: Off" Style="{StaticResource BtnStyle}" Padding="9,4" FontSize="11" Margin="0,2,6,2"
                                                            Click="OnAgToggleFullPcClick" ToolTip="Grant or revoke full access to all PC drives/files, PowerShell, processes, and apps (asks confirmation first)"/>
                                                    <Button x:Name="AgFullUiBtn" Content="Full UI: Off" Style="{StaticResource BtnStyle}" Padding="9,4" FontSize="11" Margin="0,2,6,2"
                                                            Click="OnAgToggleFullUiClick" ToolTip="Enable or disable full Windows desktop UI control (mouse, keyboard, window manager, UI Automation &amp; apps)"/>
                                                    <Border Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="9,4" Margin="0,2,6,2">
                                                        <TextBlock x:Name="AgChatStatusPillText" Text="Local Ready" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Button x:Name="AgSettingsBtn" Content="Agent Settings" Style="{StaticResource PrimaryBtnStyle}" Padding="9,4" FontSize="11" Margin="0,2,6,2" Click="OnAgOpenSettingsDrawerClick"/>
                                                    <Button Content="Runtime" Style="{StaticResource BtnStyle}" Padding="9,4" FontSize="11" Margin="0,2,6,2" Click="OnAgOpenRuntimeDrawerClick"/>
                                                    <Button Content="Timeline" Style="{StaticResource BtnStyle}" Padding="9,4" FontSize="11" Margin="0,2,6,2" Click="OnAgShowTimelineClick" ToolTip="Inspect recent AI Agent actions"/>
                                                    <Button Content="Undo Last" Style="{StaticResource BtnStyle}" Padding="9,4" FontSize="11" Margin="0,2,0,2" Click="OnAgUndoLastClick" ToolTip="Undo the most recent agent file edit or UI action (Ctrl+Z)"/>
                                                </WrapPanel>
                                            </Border>

                                            <!-- Chat Stream + Empty Starter Grid -->
                                            <ScrollViewer x:Name="AgChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,18">
                                                <Grid MaxWidth="780" HorizontalAlignment="Stretch">
                                                    <!-- Empty / Welcome Screen (ChatGPT style) -->
                                                    <StackPanel x:Name="AgWelcomePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,36,0,24">
                                                        <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentPrimary}" HorizontalAlignment="Center" Margin="0,0,0,14">
                                                            <TextBlock Text="AI" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="What can I help with on this Windows PC?" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                                        <TextBlock x:Name="AgWelcomeSubText" Text="Scoped exclusively to this installed device — never dispatches to other hosts." FontSize="12.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,24"/>

                                                        <UniformGrid Columns="2" MaxWidth="660">
                                                            <Button Style="{StaticResource BtnStyle}" Margin="0,0,6,10" Padding="14,12" HorizontalContentAlignment="Left" Click="OnAgStarterClick" Tag="/ui">
                                                                <StackPanel>
                                                                    <TextBlock Text="Inspect Active Windows UI" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                                    <TextBlock Text="List interactive buttons, inputs &amp; coordinates" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Style="{StaticResource BtnStyle}" Margin="6,0,0,10" Padding="14,12" HorizontalContentAlignment="Left" Click="OnAgStarterClick" Tag="/som">
                                                                <StackPanel>
                                                                    <TextBlock Text="Set-of-Marks Screen Map" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                                    <TextBlock Text="Capture desktop with numbered [1]..[N] UI badges" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Style="{StaticResource BtnStyle}" Margin="0,0,6,0" Padding="14,12" HorizontalContentAlignment="Left" Click="OnAgStarterClick" Tag="/windows">
                                                                <StackPanel>
                                                                    <TextBlock Text="Manage Open Windows" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                                    <TextBlock Text="List, focus, maximize, minimize, resize or close apps" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Style="{StaticResource BtnStyle}" Margin="6,0,0,0" Padding="14,12" HorizontalContentAlignment="Left" Click="OnAgStarterClick" Tag="/sysinfo">
                                                                <StackPanel>
                                                                    <TextBlock Text="System Health &amp; Pipe" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                                    <TextBlock Text="CPU, RAM, top processes &amp; C++ pipe status" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </UniformGrid>
                                                    </StackPanel>

                                                    <!-- Active Chat Messages -->
                                                    <ItemsControl x:Name="AgMessagesList" Visibility="Collapsed">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,18">
                                                                    <!-- User Bubble (Right aligned pill) -->
                                                                    <Border Visibility="{Binding UserBubbleVisibility}" HorizontalAlignment="Right" MaxWidth="560"
                                                                            Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="16" Padding="14,10">
                                                                        <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                                                 Foreground="{DynamicResource TextPrimary}" FontSize="13" TextWrapping="Wrap"/>
                                                                    </Border>

                                                                    <!-- Assistant Bubble (Left aligned clean row) -->
                                                                    <Grid Visibility="{Binding AssistantBubbleVisibility}" HorizontalAlignment="Left" MaxWidth="740">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="34"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="8" Background="{DynamicResource AccentPrimary}" VerticalAlignment="Top" Margin="0,2,0,0">
                                                                            <TextBlock Text="AI" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1">
                                                                            <Border Visibility="{Binding ToolsVisibility}" Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="0,0,0,6" HorizontalAlignment="Left">
                                                                                <StackPanel>
                                                                                    <TextBlock Text="{Binding ToolsSummary}" FontSize="10.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource IndigoText}"/>
                                                                                    <Expander Visibility="{Binding ToolDetailsVisibility}" Header="Inspect execution steps" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" IsExpanded="False">
                                                                                        <TextBox Text="{Binding ToolDetails, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="{DynamicResource ConsoleCardBg}" Foreground="#CBD5E1"
                                                                                                 FontFamily="Consolas" FontSize="10.5" Padding="8" Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto"/>
                                                                                    </Expander>
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                                                     Foreground="{DynamicResource TextPrimary}" FontSize="13" TextWrapping="Wrap"/>
                                                                            <Border Visibility="{Binding ScreenshotVisibility}" Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,8,0,0" HorizontalAlignment="Left"
                                                                                    Cursor="Hand" MouseLeftButtonUp="OnAgScreenshotClick" Tag="{Binding ScreenshotImage}" ToolTip="Click to view full-size screenshot">
                                                                                <Image Source="{Binding ScreenshotImage}" MaxHeight="260" Stretch="Uniform"/>
                                                                            </Border>
                                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                                <TextBlock Text="{Binding Timestamp}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                                                <Button Content="Copy" Style="{StaticResource GhostBtnStyle}" Padding="6,1" FontSize="10" Margin="8,0,0,0" Click="OnAgCopyMessageClick" Tag="{Binding Content}"/>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </ScrollViewer>

                                            <!-- Floating Rounded Composer -->
                                            <Border Grid.Row="2" Padding="20,6,20,18">
                                                <Border MaxWidth="780" Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource BorderHover}" BorderThickness="1" CornerRadius="16" Padding="14,10,12,10">
                                                    <StackPanel>
                                                        <TextBox x:Name="AgPromptBox" MinHeight="38" MaxHeight="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" FontSize="13"
                                                                 PreviewKeyDown="OnAgPromptKeyDown" ToolTip="Message agent for this Windows device (Enter to send, Shift+Enter for newline)"/>
                                                        <Grid Margin="0,8,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="/ui · /som · /click · /type · /open · /dir · /ps · /screenshot · /sysinfo" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Content="Clear" Style="{StaticResource GhostBtnStyle}" Padding="8,5" FontSize="11.5" Click="OnAgNewChatClick" Margin="0,0,6,0"/>
                                                                <Button x:Name="AgSendBtn" Content="Send ↑" Style="{StaticResource PrimaryBtnStyle}" Padding="14,6" FontSize="12" Click="OnAgSendChatClick"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                        </Grid>

                                        <!-- COLLAPSIBLE RIGHT DRAWER: AGENT SETTINGS (AI API, PROMPT, FUNCTIONS) & RUNTIME -->
                                        <Border x:Name="AgSidePanel" Grid.Column="2" Width="420" Visibility="Collapsed" Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1,0,0,0" Padding="14">
                                            <DockPanel>
                                                <!-- Drawer Header + Sub-tabs -->
                                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Agent Settings &amp; Controls" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="✕" Style="{StaticResource ChipBtnStyle}" Click="OnAgToggleDrawerClick"/>
                                                    </Grid>
                                                    <UniformGrid Columns="3">
                                                        <Button x:Name="AgDrawerTabAiBtn" Content="AI &amp; Prompt" Style="{StaticResource PrimaryBtnStyle}" Padding="6,6" FontSize="11" Margin="0,0,3,0" Click="OnAgDrawerTabClick" Tag="ai"/>
                                                        <Button x:Name="AgDrawerTabFnBtn" Content="Functions" Style="{StaticResource BtnStyle}" Padding="6,6" FontSize="11" Margin="2,0,2,0" Click="OnAgDrawerTabClick" Tag="functions"/>
                                                        <Button x:Name="AgDrawerTabSysBtn" Content="Runtime &amp; Pipe" Style="{StaticResource BtnStyle}" Padding="6,6" FontSize="11" Margin="3,0,0,0" Click="OnAgDrawerTabClick" Tag="runtime"/>
                                                    </UniformGrid>
                                                </StackPanel>

                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel>
                                                        <!-- TAB 1: AI API CONNECTION, SYSTEM PROMPT & INSTRUCTION NAME -->
                                                        <StackPanel x:Name="AgDrawerAiPanel" Visibility="Visible">
                                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                                                <StackPanel>
                                                                    <TextBlock Text="Agent Identity &amp; System Instructions" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                                                        <StackPanel Margin="0,0,4,0">
                                                                            <TextBlock Text="Agent Name" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3"/>
                                                                            <TextBox x:Name="AgSetNameBox" Style="{StaticResource FieldStyle}" Text="Windows Copilot"/>
                                                                        </StackPanel>
                                                                        <StackPanel Margin="4,0,0,0">
                                                                            <TextBlock Text="Instruction Name" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3"/>
                                                                            <TextBox x:Name="AgSetInstructionNameBox" Style="{StaticResource FieldStyle}" Text="Default Windows Assistant"/>
                                                                        </StackPanel>
                                                                    </UniformGrid>
                                                                    <TextBlock Text="System Prompt" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,3"/>
                                                                    <TextBox x:Name="AgSetSystemPromptBox" Style="{StaticResource FieldStyle}" Height="92" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"/>
                                                                    <UniformGrid Columns="2">
                                                                        <StackPanel Margin="0,0,4,0">
                                                                            <TextBlock Text="Temperature (0.0 - 2.0)" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3"/>
                                                                            <TextBox x:Name="AgSetTempBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas" Text="0.2"/>
                                                                        </StackPanel>
                                                                        <StackPanel Margin="4,0,0,0">
                                                                            <TextBlock Text="Max Tool Steps (1 - 20)" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3"/>
                                                                            <TextBox x:Name="AgSetMaxStepsBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas" Text="8"/>
                                                                        </StackPanel>
                                                                    </UniformGrid>
                                                                </StackPanel>
                                                            </Border>

                                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                                                <StackPanel>
                                                                    <TextBlock Text="AI API Connection" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                                                    <TextBlock Text="Routing Mode" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3"/>
                                                                    <ComboBox x:Name="AgSetConnModeCombo" Style="{StaticResource SaaSComboBoxStyle}" SelectedIndex="0" Margin="0,0,0,6">
                                                                        <ComboBoxItem Content="Auto (Direct API Key if set → Local Tools)" Tag="direct_or_local"/>
                                                                        <ComboBoxItem Content="Direct AI API (Execute Tools Directly on This PC)" Tag="direct_api"/>
                                                                        <ComboBoxItem Content="Via Control Plane (/api/ai/chat)" Tag="control_plane"/>
                                                                        <ComboBoxItem Content="Local Windows Tools Only (No AI API)" Tag="local_only"/>
                                                                    </ComboBox>

                                                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                                                        <StackPanel Margin="0,0,4,0">
                                                                            <TextBlock Text="AI Provider" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3"/>
                                                                            <ComboBox x:Name="AgSetProviderCombo" Style="{StaticResource SaaSComboBoxStyle}" SelectionChanged="OnAgSettingsProviderChanged">
                                                                                <ComboBoxItem Content="openai" Tag="openai"/>
                                                                                <ComboBoxItem Content="anthropic" Tag="anthropic"/>
                                                                                <ComboBoxItem Content="gemini" Tag="gemini"/>
                                                                                <ComboBoxItem Content="ollama" Tag="ollama"/>
                                                                                <ComboBoxItem Content="custom" Tag="custom"/>
                                                                            </ComboBox>
                                                                        </StackPanel>
                                                                        <StackPanel Margin="4,0,0,0">
                                                                            <TextBlock Text="Model Name" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3"/>
                                                                            <TextBox x:Name="AgSetModelBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas" Text="gpt-4o"/>
                                                                        </StackPanel>
                                                                    </UniformGrid>

                                                                    <TextBlock Text="API Base URL" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3"/>
                                                                    <TextBox x:Name="AgSetBaseUrlBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas" Text="https://api.openai.com/v1" Margin="0,0,0,6"/>

                                                                    <TextBlock Text="AI API Key (DPAPI-encrypted locally)" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3"/>
                                                                    <PasswordBox x:Name="AgSetApiKeyBox" Style="{StaticResource PasswordFieldStyle}" FontFamily="Consolas" ToolTip="Leave unchanged or paste OpenAI / Anthropic / Gemini key" Margin="0,0,0,8"/>

                                                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                                                        <Button Content="Test AI API" Style="{StaticResource BtnStyle}" Padding="8,6" FontSize="11.5" Margin="0,0,4,0" Click="OnAgTestApiClick"/>
                                                                        <Button Content="Save Agent Settings" Style="{StaticResource PrimaryBtnStyle}" Padding="8,6" FontSize="11.5" Margin="4,0,0,0" Click="OnAgSaveSettingsClick"/>
                                                                    </UniformGrid>
                                                                    <TextBlock x:Name="AgApiTestStatusText" Text="Configure your AI provider and prompt, then Save." FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- TAB 2: DEVICE FUNCTIONS ALLOW / DISALLOW -->
                                                        <StackPanel x:Name="AgDrawerFunctionsPanel" Visibility="Collapsed">
                                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                                                <StackPanel>
                                                                    <Grid Margin="0,0,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="Device Functions Allow / Disallow" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                            <Button Content="Allow All" Style="{StaticResource ChipBtnStyle}" FontSize="10.5" Margin="0,0,4,0" Click="OnAgAllowAllFunctionsClick"/>
                                                                            <Button Content="Read-Only" Style="{StaticResource ChipBtnStyle}" FontSize="10.5" Click="OnAgReadOnlyFunctionsClick"/>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <CheckBox x:Name="AgFnSysHealthChk" Style="{StaticResource ToggleSwitchStyle}" Content="System Health, Telemetry, Processes &amp; Monitors"/>
                                                                    <CheckBox x:Name="AgFnScreenCaptureChk" Style="{StaticResource ToggleSwitchStyle}" Content="Screen Capture &amp; Set-of-Marks Vision"/>
                                                                    <CheckBox x:Name="AgFnWindowMgmtChk" Style="{StaticResource ToggleSwitchStyle}" Content="Window Management (Focus, Max, Min, Close, Resize)"/>
                                                                    <CheckBox x:Name="AgFnUiInputChk" Style="{StaticResource ToggleSwitchStyle}" Content="UI Automation, Mouse Clicks, Typing &amp; Hotkeys"/>
                                                                    <CheckBox x:Name="AgFnClipboardChk" Style="{StaticResource ToggleSwitchStyle}" Content="Clipboard Read &amp; Write"/>
                                                                    <CheckBox x:Name="AgFnAppLaunchChk" Style="{StaticResource ToggleSwitchStyle}" Content="Launch Applications"/>
                                                                    <CheckBox x:Name="AgFnWorkspaceFilesChk" Style="{StaticResource ToggleSwitchStyle}" Content="Workspace File Read, Search &amp; Edit"/>
                                                                    <CheckBox x:Name="AgFnFullPcFilesChk" Style="{StaticResource ToggleSwitchStyle}" Content="Full PC Drives, Directories &amp; Files (if allowed)"/>
                                                                    <CheckBox x:Name="AgFnShellPsChk" Style="{StaticResource ToggleSwitchStyle}" Content="CMD Shell &amp; PowerShell Execution (if allowed)"/>
                                                                    <CheckBox x:Name="AgFnKillProcChk" Style="{StaticResource ToggleSwitchStyle}" Content="Terminate Running Processes (kill_process)"/>
                                                                    <CheckBox x:Name="AgFnConfirmMutateChk" Style="{StaticResource ToggleSwitchStyle}" Content="Ask confirmation popup before every mutating function"/>

                                                                    <TextBlock Text="Disallowed Function Names (comma-separated blocklist)" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,3"/>
                                                                    <TextBox x:Name="AgSetDisabledToolsBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas" ToolTip="Example: close_window, delete_workspace_file" Margin="0,0,0,8"/>

                                                                    <Button Content="Save Function Permissions" Style="{StaticResource PrimaryBtnStyle}" Padding="10,6" FontSize="11.5" Click="OnAgSaveSettingsClick"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- TAB 3: CONTROL PLANE RUNTIME, C++ PIPE & SCHEDULED AGENTS -->
                                                        <StackPanel x:Name="AgDrawerRuntimePanel" Visibility="Collapsed">
                                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                                                <StackPanel>
                                                                    <TextBlock Text="Control Plane Operator Auth (Optional)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                                                    <TextBlock x:Name="AgAuthStatusText" Text="Sign in only if routing via Control Plane or syncing scheduled device agents." FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                                    <ComboBox x:Name="AgAuthModeCombo" Style="{StaticResource SaaSComboBoxStyle}" SelectedIndex="0" SelectionChanged="OnAgentAuthModeChanged" Margin="0,0,0,6">
                                                                        <ComboBoxItem Content="Username / Password" Tag="creds"/>
                                                                        <ComboBoxItem Content="Admin Token" Tag="token"/>
                                                                    </ComboBox>
                                                                    <StackPanel x:Name="AgCredsPanel">
                                                                        <TextBox x:Name="AgUserBox" Style="{StaticResource FieldStyle}" Text="admin" ToolTip="Username" Margin="0,0,0,6"/>
                                                                        <PasswordBox x:Name="AgPassBox" Style="{StaticResource PasswordFieldStyle}" ToolTip="Password" Margin="0,0,0,6"/>
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="AgTokenPanel" Visibility="Collapsed">
                                                                        <PasswordBox x:Name="AgAdminTokenBox" Style="{StaticResource PasswordFieldStyle}" FontFamily="Consolas" ToolTip="X-Admin-Token" Margin="0,0,0,6"/>
                                                                    </StackPanel>
                                                                    <PasswordBox x:Name="AgApiKeyBox" Style="{StaticResource PasswordFieldStyle}" FontFamily="Consolas" ToolTip="Optional Control Plane LLM Key Override" Margin="0,0,0,8"/>
                                                                    <Button Content="Authenticate &amp; Sync" Style="{StaticResource PrimaryBtnStyle}" Padding="10,6" FontSize="11.5" Click="OnAgentsAuthenticateAndLoadClick"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                                                <StackPanel>
                                                                    <TextBlock Text="Local Worker &amp; C++ Desktop Pipe" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                                                    <TextBlock x:Name="AgPipeMetaText" Text="\\.\pipe\AIBridgeDesktopPipe" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                                                                    <WrapPanel Margin="0,0,0,8">
                                                                        <Button Content="Start / Stop" Style="{StaticResource BtnStyle}" Padding="8,4" FontSize="11" Click="OnToggleAgentClick" Margin="0,2,4,2"/>
                                                                        <Button Content="Ping Pipe" Style="{StaticResource BtnStyle}" Padding="8,4" FontSize="11" Click="OnAgentPipePingClick" Margin="0,2,4,2"/>
                                                                        <Button Content="Pipe Status &amp; H.264" Style="{StaticResource BtnStyle}" Padding="8,4" FontSize="11" Click="OnAgentPipeStatusClick" Margin="0,2,4,2"/>
                                                                        <Button Content="C++ Self-Test" Style="{StaticResource BtnStyle}" Padding="8,4" FontSize="11" Click="OnAgentCppSelfTestClick" Margin="0,2,4,2"/>
                                                                        <Button Content="Restart Pipe" Style="{StaticResource BtnStyle}" Padding="8,4" FontSize="11" Click="OnAgentRestartPipeClick" Margin="0,2,4,2"/>
                                                                        <Button Content="Push Policy" Style="{StaticResource BtnStyle}" Padding="8,4" FontSize="11" Click="OnAgentPipePushPolicyClick" Margin="0,2,4,2"/>
                                                                        <Button Content="Release Input" Style="{StaticResource DangerBtnStyle}" Padding="8,4" FontSize="11" Click="OnAgentPipeReleaseInputClick" Margin="0,2,0,2"/>
                                                                    </WrapPanel>
                                                                    <TextBox x:Name="AgPipeConsoleBox" Height="96" Background="{DynamicResource ConsoleCardBg}" Foreground="#CBD5E1"
                                                                             BorderThickness="0" FontFamily="Consolas" FontSize="10.5" IsReadOnly="True" Padding="8"
                                                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="Pipe output appears here."/>
                                                                </StackPanel>
                                                            </Border>

                                                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="10" Padding="12">
                                                                <StackPanel>
                                                                    <Grid Margin="0,0,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="Scheduled Agents (This PC)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                                        <Button Grid.Column="1" Content="Refresh" Style="{StaticResource GhostBtnStyle}" Padding="6,2" FontSize="11" Click="OnAgentsRefreshClick"/>
                                                                    </Grid>
                                                                    <DataGrid x:Name="AgCustomGrid" Style="{StaticResource MinimalDataGridStyle}" Height="125" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,0,0,8">
                                                                        <DataGrid.Columns>
                                                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="58"/>
                                                                            <DataGridTemplateColumn Header="Actions" Width="96">
                                                                                <DataGridTemplateColumn.CellTemplate>
                                                                                    <DataTemplate>
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <Button Content="{Binding ToggleLabel}" Style="{StaticResource BtnStyle}" Padding="5,2" FontSize="10.5" Click="OnToggleCustomAgentClick" Tag="{Binding}" Margin="0,0,3,0"/>
                                                                                            <Button Content="Run" Style="{StaticResource PrimaryBtnStyle}" Padding="5,2" FontSize="10.5" Click="OnRunCustomAgentClick" Tag="{Binding}"/>
                                                                                        </StackPanel>
                                                                                    </DataTemplate>
                                                                                </DataGridTemplateColumn.CellTemplate>
                                                                            </DataGridTemplateColumn>
                                                                        </DataGrid.Columns>
                                                                    </DataGrid>
                                                                    <TextBox x:Name="AgNewNameBox" Style="{StaticResource FieldStyle}" Text="health-watchdog" Margin="0,0,0,6"/>
                                                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                                                        <ComboBox x:Name="AgNewProviderCombo" Style="{StaticResource SaaSComboBoxStyle}" SelectedIndex="0" Margin="0,0,3,0">
                                                                            <ComboBoxItem Content="openai"/>
                                                                            <ComboBoxItem Content="anthropic"/>
                                                                            <ComboBoxItem Content="gemini"/>
                                                                            <ComboBoxItem Content="ollama"/>
                                                                        </ComboBox>
                                                                        <TextBox x:Name="AgNewIntervalBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas" Text="300" Margin="3,0,0,0"/>
                                                                    </UniformGrid>
                                                                    <TextBox x:Name="AgNewInstructionBox" Style="{StaticResource FieldStyle}" Text="Monitor CPU/RAM and check workspace health." Margin="0,0,0,6"/>
                                                                    <Button Content="+ Create Device Agent" Style="{StaticResource PrimaryBtnStyle}" Padding="10,5" FontSize="11.5" Click="OnCreateCustomAgentClick"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Grid>

            <!-- FULL-WINDOW SIGN-IN & DEVICE ENROLLMENT PAGE (shown automatically when not enrolled) -->
            <Grid x:Name="SignInPageOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="{DynamicResource BgCanvas}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Draggable Caption & Theme Controls -->
                <Border Grid.Row="0" Background="{DynamicResource BgCanvas}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="0,0,0,1" Padding="20,0,12,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource AccentPrimary}" Margin="0,0,8,0">
                                <TextBlock Text="AI" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="AI Bridge" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <TextBlock Text=" · Device Onboarding" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource BtnStyle}" Padding="7,6" WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="OnToggleThemeClick" Margin="0,0,8,0" ToolTip="Toggle Dark / Light Theme">
                                <TextBlock x:Name="SignInThemeIcon" Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                            </Button>
                            <Button Content="&#xE921;" Style="{StaticResource CaptionBtnStyle}" Click="OnMinimizeWindowClick" ToolTip="Minimize"/>
                            <Button Content="&#xE922;" Style="{StaticResource CaptionBtnStyle}" Click="OnMaximizeRestoreClick" ToolTip="Maximize / Restore"/>
                            <Button Content="&#xE8BB;" Style="{StaticResource CaptionBtnStyle}" Click="OnCloseToTrayClick" ToolTip="Close"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Centered SaaS Sign-In & Onboarding Wizard Card -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Width="472" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                            Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="14" Padding="28">
                        <StackPanel PreviewKeyDown="OnSignInKeyDown">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentPrimary}" Margin="0,0,12,0">
                                    <TextBlock Text="AI" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Sign in to AI Bridge" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Enroll this Windows workstation with your Control Plane" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Multi-Step Progress Bar (#09) -->
                            <ProgressBar x:Name="SignInWizProgress" Height="4" Minimum="0" Maximum="100" Value="50"
                                         Foreground="{DynamicResource AccentPrimary}" Background="{DynamicResource BgElevated}" BorderThickness="0" Margin="0,0,0,12"/>
                            <UniformGrid Columns="2" Margin="0,0,0,16">
                                <Button x:Name="WizTab1Btn" Content="1 · Endpoint &amp; Auth" Style="{StaticResource ChipActiveStyle}" Click="OnWizStepTabClick" Tag="1" Margin="0,0,4,0"/>
                                <Button x:Name="WizTab2Btn" Content="2 · Workstation Guardrails" Style="{StaticResource ChipBtnStyle}" Click="OnWizStepTabClick" Tag="2" Margin="4,0,0,0"/>
                            </UniformGrid>

                            <!-- STEP 1: ENDPOINT & AUTH -->
                            <StackPanel x:Name="SignInStep1Panel">
                                <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="9" Padding="4" Margin="0,0,0,16">
                                    <UniformGrid Columns="2">
                                        <Button x:Name="SignInModeAccountBtn" Content="Sign In with Account" Style="{StaticResource ChipActiveStyle}" Click="OnSignInModeClick" Tag="ACCOUNT"/>
                                        <Button x:Name="SignInModeTokenBtn" Content="Use Device / Admin Token" Style="{StaticResource ChipBtnStyle}" Click="OnSignInModeClick" Tag="TOKEN"/>
                                    </UniformGrid>
                                </Border>

                                <TextBlock Text="Control Plane URL" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SignInUrlBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas"/>
                                    <Button Grid.Column="1" Content="Ping" Style="{StaticResource BtnStyle}" Padding="12,7" Click="OnSignInPingClick" Margin="8,0,0,0"/>
                                </Grid>

                                <TextBlock Text="Workstation Name / Device ID" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                <TextBox x:Name="SignInDeviceNameBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas" Margin="0,0,0,12"/>

                                <StackPanel x:Name="SignInAccountPanel">
                                    <TextBlock Text="Username" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="SignInUsernameBox" Style="{StaticResource FieldStyle}" Tag="admin or user email" Margin="0,0,0,12"/>

                                    <TextBlock Text="Password" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                    <PasswordBox x:Name="SignInPasswordBox" Style="{StaticResource PasswordFieldStyle}" Margin="0,0,0,14"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" x:Name="SignInAccountSubmitBtn" Content="Sign In &amp; Enroll Device" Style="{StaticResource PrimaryBtnStyle}"
                                                Padding="14,10" FontSize="13" Click="OnSignInAccountSubmitClick"/>
                                        <Button Grid.Column="1" Content="Guardrails →" Style="{StaticResource BtnStyle}" Padding="12,10" Margin="8,0,0,0" Click="OnWizStepTabClick" Tag="2"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel x:Name="SignInTokenPanel" Visibility="Collapsed">
                                    <TextBlock Text="Device Token or Admin Token" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                    <PasswordBox x:Name="SignInTokenBox" Style="{StaticResource PasswordFieldStyle}" FontFamily="Consolas" Margin="0,0,0,14"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" x:Name="SignInTokenSubmitBtn" Content="Verify &amp; Connect" Style="{StaticResource PrimaryBtnStyle}"
                                                Padding="14,10" FontSize="13" Click="OnSignInTokenSubmitClick"/>
                                        <Button Grid.Column="1" Content="Guardrails →" Style="{StaticResource BtnStyle}" Padding="12,10" Margin="8,0,0,0" Click="OnWizStepTabClick" Tag="2"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <!-- STEP 2: INITIAL GUARDRAILS PRESET -->
                            <StackPanel x:Name="SignInStep2Panel" Visibility="Collapsed">
                                <TextBlock Text="Choose initial execution permissions for this workstation before connecting:"
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <CheckBox x:Name="WizAllowWritesChk" IsChecked="True" Style="{StaticResource ToggleSwitchStyle}" Content="Allow Tier 2: Workspace file writes"/>
                                <CheckBox x:Name="WizAllowTier3Chk" IsChecked="True" Style="{StaticResource ToggleSwitchStyle}" Content="Allow Tier 3: Desktop vision &amp; screenshots"/>
                                <CheckBox x:Name="WizAllowDesktopChk" IsChecked="False" Style="{StaticResource ToggleSwitchStyle}" Content="Allow Interactive Desktop Control (SendInput / UI Automation)"/>
                                <CheckBox x:Name="WizAllowShellChk" IsChecked="False" Style="{StaticResource ToggleSwitchStyle}" Content="Allow Shell Execution (run_shell)" Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="← Back" Style="{StaticResource BtnStyle}" Padding="12,10" Click="OnWizStepTabClick" Tag="1" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="Apply Guardrails &amp; Sign In" Style="{StaticResource PrimaryBtnStyle}" Padding="14,10" FontSize="13" Click="OnWizApplyAndSubmitClick"/>
                                </Grid>
                            </StackPanel>

                            <TextBlock x:Name="SignInStatusText" Text="" FontSize="11.5" FontFamily="Consolas" Foreground="{DynamicResource WarningText}"
                                       TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

                            <Border Height="1" Background="{DynamicResource BorderHairline}" Margin="0,18,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Sealed with Windows DPAPI (CurrentUser)" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Continue offline →" Style="{StaticResource ChipBtnStyle}" Click="OnSignInContinueOfflineClick"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- SLIDE-OVER INSPECTOR DRAWER (#17) -->
            <Grid x:Name="InspectorDrawerOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#77000000" MouseDown="OnDrawerBackdropClick">
                <Border x:Name="InspectorDrawerPanel" HorizontalAlignment="Right" Width="430"
                        Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1,0,0,0" Padding="22">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="DrawerSlideTransform" X="0"/>
                    </Border.RenderTransform>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="DrawerTitleText" Text="Workstation Inspector" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="DrawerSubtitleText" Text="Live runtime metadata" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="&#xE8BB;" Style="{StaticResource IconBtnStyle}" Click="OnCloseDrawerClick" ToolTip="Close Drawer"/>
                        </Grid>

                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Copy Details" Style="{StaticResource BtnStyle}" HorizontalAlignment="Left" Click="OnCopyDrawerDetailClick"/>
                                <Button Grid.Column="1" Content="Done" Style="{StaticResource PrimaryBtnStyle}" Click="OnCloseDrawerClick"/>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource ConsoleCardBg}" BorderBrush="#1A1E2B" BorderThickness="1" CornerRadius="10" Padding="12">
                            <TextBox x:Name="DrawerDetailBox" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- TOAST -->
            <Border x:Name="ToastBanner" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,22,20" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHover}" BorderThickness="1" CornerRadius="10" Padding="14,9">
                <TextBlock x:Name="ToastText" Text="" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
            </Border>

            <!-- COMMAND PALETTE MODAL (Ctrl+K) -->
            <Grid x:Name="CommandPaletteOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#88000000" MouseDown="OnOverlayBackdropClick">
                <Border Width="440" VerticalAlignment="Top" Margin="0,96,0,0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="12">
                    <StackPanel>
                        <Grid Margin="4,0,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Jump to view" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Esc" Style="{StaticResource ChipBtnStyle}" Click="OnCloseCommandPaletteClick"/>
                        </Grid>
                        <TextBox x:Name="CommandSearchBox" Style="{StaticResource FieldStyle}" Tag="Search commands or views..."
                                 TextChanged="OnCommandSearchChanged" PreviewKeyDown="OnCommandBoxKeyDown" Margin="0,0,0,8"/>
                        <ListBox x:Name="CommandResultsList" MaxHeight="240" Background="Transparent"
                                 Foreground="{DynamicResource TextPrimary}" BorderThickness="0" DisplayMemberPath="Label"
                                 MouseDoubleClick="OnCommandItemDoubleClick"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- DEVICE ENROLLMENT MODAL -->
            <Grid x:Name="EnrollModalOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#88000000">
                <Border Width="460" VerticalAlignment="Center" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Enroll Windows Device" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Exchange a one-time enrollment token from the Control Plane for a DPAPI-sealed device token."
                                   FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,14"/>

                        <TextBlock Text="Control Plane URL" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="EnrollUrlBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas" Margin="0,0,0,10"/>

                        <TextBlock Text="Device ID" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="EnrollDeviceIdBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas" Margin="0,0,0,10"/>

                        <TextBlock Text="One-Time Enrollment Token" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="EnrollTokenBox" Style="{StaticResource FieldStyle}" FontFamily="Consolas" Margin="0,0,0,12"/>

                        <TextBlock x:Name="EnrollStatusText" Text="" FontSize="11.5" FontFamily="Consolas" Foreground="#F59E0B" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Style="{StaticResource BtnStyle}" Click="OnCloseEnrollModalClick" Margin="0,0,8,0"/>
                            <Button Content="Enroll &amp; Connect" Style="{StaticResource PrimaryBtnStyle}" Click="OnSubmitEnrollClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SCREENSHOT LIGHTBOX MODAL -->
            <Grid x:Name="ScreenshotLightboxOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#CC000000" MouseLeftButtonUp="OnCloseLightboxClick">
                <Border Margin="42" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" CornerRadius="14" Padding="14">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Screenshot Preview (click anywhere to close)" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="✕ Close" Style="{StaticResource BtnStyle}" Padding="10,4" FontSize="11.5" Click="OnCloseLightboxBtnClick"/>
                        </Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Image x:Name="LightboxImage" Stretch="Uniform"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- LOCAL WORKSTATION APPROVAL MODAL -->
            <Grid x:Name="ApprovalModalOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#88000000">
                <Border Width="500" VerticalAlignment="Center" Background="{DynamicResource BgCard}" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="WORKSTATION APPROVAL REQUIRED" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B"/>
                        <TextBlock x:Name="ApprovalTitleText" Text="Task Execution Request" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,10"/>
                        <Border Background="{DynamicResource ConsoleCardBg}" BorderBrush="#1A1E2B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <TextBox x:Name="ApprovalArgsBox" Height="150" Background="Transparent" Foreground="#CBD5E1"
                                     BorderThickness="0" FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Deny" Style="{StaticResource DangerBtnStyle}" Click="OnDenyLocalApprovalClick" Margin="0,0,8,0"/>
                            <Button Content="Approve Once" Style="{StaticResource BtnStyle}" Click="OnApproveLocalApprovalClick" Margin="0,0,8,0"/>
                            <Button Content="Always Allow (Don't Ask Again)" Style="{StaticResource PrimaryBtnStyle}" Click="OnApproveAlwaysLocalApprovalClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
