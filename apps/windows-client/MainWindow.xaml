<Window x:Class="AIBridgeClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Bridge Windows Client (Native C#)"
        Width="1240" Height="800"
        MinWidth="1000" MinHeight="660"
        Background="#090D16"
        Foreground="#F1F5F9"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#1E293B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- Custom SaaS Title Bar -->
            <Border Grid.Row="0" Background="#0C111D" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Width="20" Height="20" CornerRadius="5" Background="#2563EB" Margin="0,0,9,0">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="AI Bridge" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                        <Border Background="#16233B" BorderBrush="#263B5E" BorderThickness="1" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="NATIVE C# · v0.3.0" FontSize="9.5" FontWeight="SemiBold" FontFamily="Consolas" Foreground="#60A5FA"/>
                        </Border>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="&#xE921;" Style="{StaticResource CaptionBtnStyle}" Click="OnMinimizeWindowClick" ToolTip="Minimize to Taskbar"/>
                        <Button Content="&#xE922;" Style="{StaticResource CaptionBtnStyle}" Click="OnMaximizeRestoreClick" ToolTip="Maximize / Restore"/>
                        <Button Content="&#xE8BB;" Style="{StaticResource CaptionBtnStyle}" Click="OnCloseToTrayClick" ToolTip="Minimize to System Tray"/>
                    </StackPanel>

                    <TextBlock x:Name="TitleBarHostText" Text="WORKSTATION" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="11" FontFamily="Consolas" Foreground="#64748B"/>
                </DockPanel>
            </Border>

            <!-- Main Workspace -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar Navigation -->
                <Border Grid.Column="0" Background="#0C111D" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Padding="14,16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="CONTROL PLANE LINK" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8" Fill="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="SidebarStatusText" Text="Disconnected" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SidebarHostText" Text="Outbound-only poller" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="OPERATIONS" FontSize="10" FontWeight="SemiBold" Foreground="#475569" Margin="10,0,0,8"/>

                            <Button x:Name="NavOverviewBtn" Style="{StaticResource NavButtonActiveStyle}" Click="OnNavClick" Tag="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Overview" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavTasksBtn" Style="{StaticResource NavButtonStyle}" Click="OnNavClick" Tag="1" Margin="0,3,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Task Explorer" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavMonitorBtn" Style="{StaticResource NavButtonStyle}" Click="OnNavClick" Tag="2" Margin="0,3,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="System Monitor" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavVisionBtn" Style="{StaticResource NavButtonStyle}" Click="OnNavClick" Tag="3" Margin="0,3,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Desktop Vision" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="GOVERNANCE" FontSize="10" FontWeight="SemiBold" Foreground="#475569" Margin="10,18,0,8"/>

                            <Button x:Name="NavSecurityBtn" Style="{StaticResource NavButtonStyle}" Click="OnNavClick" Tag="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Security &amp; Policy" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavSettingsBtn" Style="{StaticResource NavButtonStyle}" Click="OnNavClick" Tag="5" Margin="0,3,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Settings" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Main Content Viewport -->
                <Grid Grid.Column="1" Margin="24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Page Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,18">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock x:Name="PageTitleText" Text="Overview" FontSize="22" FontWeight="Bold" Foreground="#F1F5F9"/>
                            <TextBlock x:Name="PageSubtitleText" Text="Agent status, connection, and live activity" FontSize="12.5" Foreground="#94A3B8" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="HeaderToggleAgentBtn" Content="Start Agent" Style="{StaticResource PrimaryButtonStyle}" Click="OnToggleAgentClick" Margin="0,0,8,0"/>
                            <Button Content="Ping Server" Style="{StaticResource SecondaryButtonStyle}" Click="OnPingClick" Margin="0,0,8,0"/>
                            <Button Content="Open Dashboard" Style="{StaticResource SecondaryButtonStyle}" Click="OnOpenDashboardClick"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Tab Content -->
                    <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </TabControl.ItemContainerStyle>

                        <!-- TAB 0: OVERVIEW -->
                        <TabItem Header="Overview">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Bento KPI Cards -->
                                <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,14">
                                    <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,12,0">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="CONNECTION" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="&#xE703;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#64748B" DockPanel.Dock="Right"/>
                                            </DockPanel>
                                            <TextBlock x:Name="KpiStatusText" Text="Disconnected" FontSize="19" FontWeight="Bold" FontFamily="Consolas" Foreground="#F1F5F9" Margin="0,8,0,2"/>
                                            <TextBlock Text="HTTP + WS Side-Channel" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,12,0">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="TASKS RECORDED" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="&#xE7C4;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#3B82F6" DockPanel.Dock="Right"/>
                                            </DockPanel>
                                            <TextBlock x:Name="KpiTasksText" Text="0" FontSize="19" FontWeight="Bold" FontFamily="Consolas" Foreground="#F1F5F9" Margin="0,8,0,2"/>
                                            <TextBlock Text="Local persisted history" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,12,0">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="SERVER LATENCY" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#10B981" DockPanel.Dock="Right"/>
                                            </DockPanel>
                                            <TextBlock x:Name="KpiLatencyText" Text="-- ms" FontSize="19" FontWeight="Bold" FontFamily="Consolas" Foreground="#10B981" Margin="0,8,0,2"/>
                                            <TextBlock Text="Control plane /health" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="TOKEN VAULT" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#60A5FA" DockPanel.Dock="Right"/>
                                            </DockPanel>
                                            <TextBlock Text="DPAPI Sealed" FontSize="19" FontWeight="Bold" FontFamily="Consolas" Foreground="#60A5FA" Margin="0,8,0,2"/>
                                            <TextBlock Text="User-scoped CryptProtect" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Quick Actions + Live Sparkline Card -->
                                <Grid Grid.Row="1" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,12,0">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <TextBlock Text="Endpoint &amp; Credential Controls" FontSize="13.5" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                                <TextBlock x:Name="OverviewEndpointText" Text="Control Plane: http://127.0.0.1:8000" FontSize="12" FontFamily="Consolas" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Rotate Token" Style="{StaticResource SecondaryButtonStyle}" Click="OnRotateTokenClick" Margin="0,0,8,0"/>
                                                <Button Content="Sync Policy" Style="{StaticResource SecondaryButtonStyle}" Click="OnSyncPolicyClick"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16,12">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                                <TextBlock Text="LIVE CPU TELEMETRY (60s)" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock x:Name="OverviewCpuLiveText" Text="0.0 %" FontSize="11.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#3B82F6" DockPanel.Dock="Right"/>
                                            </DockPanel>
                                            <Canvas x:Name="OverviewCpuSparkCanvas" Height="40" ClipToBounds="True">
                                                <Polyline x:Name="OverviewCpuSparkLine" Stroke="#3B82F6" StrokeThickness="2" StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </DockPanel>
                                    </Border>
                                </Grid>

                                <!-- Activity Log Terminal -->
                                <Border Grid.Row="2" Background="#070B12" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="7" Height="7" CornerRadius="3.5" Background="#10B981" Margin="0,0,8,0"/>
                                                <TextBlock Text="LIVE ACTIVITY STREAM" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                            </StackPanel>
                                            <Button DockPanel.Dock="Right" Content="Clear Log" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Click="OnClearLogClick"/>
                                        </DockPanel>
                                        <TextBox x:Name="ActivityLogBox" Background="Transparent" Foreground="#CBD5E1"
                                                 BorderThickness="0" FontFamily="Consolas" FontSize="12"
                                                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 1: TASK EXPLORER -->
                        <TabItem Header="Tasks">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="215"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                        <Button Content="All" Style="{StaticResource SecondaryButtonStyle}" Click="OnTaskFilterClick" Tag="all" Margin="0,0,6,0"/>
                                        <Button Content="Succeeded" Style="{StaticResource SecondaryButtonStyle}" Click="OnTaskFilterClick" Tag="succeeded" Margin="0,0,6,0"/>
                                        <Button Content="Failed" Style="{StaticResource SecondaryButtonStyle}" Click="OnTaskFilterClick" Tag="failed" Margin="0,0,12,0"/>
                                        <TextBox x:Name="TaskSearchBox" Width="260" Style="{StaticResource SaaSTextBoxStyle}"
                                                 TextChanged="OnTaskSearchChanged" ToolTip="Filter by Task ID or Tool Name"/>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Content="Clear History" Style="{StaticResource DangerButtonStyle}" Click="OnClearTasksClick"/>
                                </DockPanel>

                                <Border Grid.Row="1" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="2">
                                    <DataGrid x:Name="TasksGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                              Background="Transparent" Foreground="#F1F5F9" RowBackground="#111827" AlternatingRowBackground="#0E1523"
                                              BorderThickness="0" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#1E293B" HeadersVisibility="Column"
                                              SelectionChanged="OnTaskSelected">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#0C111D"/>
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                <Setter Property="Padding" Value="12,10"/>
                                                <Setter Property="FontSize" Value="11.5"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="BorderBrush" Value="#1E293B"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Task ID" Binding="{Binding Id}" Width="150"/>
                                            <DataGridTextColumn Header="Tool" Binding="{Binding Tool}" Width="*"/>
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                                            <DataGridTextColumn Header="Duration (ms)" Binding="{Binding DurationMs}" Width="115"/>
                                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="170"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <Border Grid.Row="2" Background="#070B12" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <TextBlock Text="PAYLOAD &amp; RESULT INSPECTOR" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                            <Button DockPanel.Dock="Right" Content="Copy Payload" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Click="OnCopyTaskPayloadClick"/>
                                        </DockPanel>
                                        <TextBox x:Name="TaskInspectorBox" Background="Transparent" Foreground="#CBD5E1"
                                                 BorderThickness="0" FontFamily="Consolas" FontSize="12"
                                                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 2: SYSTEM MONITOR -->
                        <TabItem Header="Monitor">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Rolling CPU & Memory Sparklines -->
                                <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,14">
                                    <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,12,0">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="CPU UTILIZATION (60s)" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock x:Name="MonCpuText" Text="0.0 %" FontSize="22" FontWeight="Bold" FontFamily="Consolas" Foreground="#3B82F6" DockPanel.Dock="Right"/>
                                            </DockPanel>
                                            <Canvas x:Name="MonCpuSparkCanvas" Height="88" Margin="0,12,0,12" ClipToBounds="True">
                                                <Polyline x:Name="MonCpuSparkLine" Stroke="#3B82F6" StrokeThickness="2.2" StrokeLineJoin="Round"/>
                                            </Canvas>
                                            <ProgressBar x:Name="MonCpuBar" Style="{StaticResource SaaSProgressBarStyle}" Maximum="100" Foreground="#3B82F6"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="18">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="MEMORY USAGE (60s)" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock x:Name="MonMemText" Text="0 / 0 GB" FontSize="22" FontWeight="Bold" FontFamily="Consolas" Foreground="#10B981" DockPanel.Dock="Right"/>
                                            </DockPanel>
                                            <Canvas x:Name="MonMemSparkCanvas" Height="88" Margin="0,12,0,12" ClipToBounds="True">
                                                <Polyline x:Name="MonMemSparkLine" Stroke="#10B981" StrokeThickness="2.2" StrokeLineJoin="Round"/>
                                            </Canvas>
                                            <ProgressBar x:Name="MonMemBar" Style="{StaticResource SaaSProgressBarStyle}" Maximum="100" Foreground="#10B981"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Disk & Network -->
                                <UniformGrid Grid.Row="1" Columns="2">
                                    <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="SYSTEM DISK" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                            <TextBlock x:Name="MonDiskText" Text="0 / 0 GB" FontSize="24" FontWeight="Bold" FontFamily="Consolas" Foreground="#F1F5F9" Margin="0,8,0,12"/>
                                            <ProgressBar x:Name="MonDiskBar" Style="{StaticResource SaaSProgressBarStyle}" Maximum="100" Foreground="#F59E0B"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="NETWORK &amp; PROCESSES" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                            <TextBlock x:Name="MonNetText" Text="Down 0.0 KB/s | Up 0.0 KB/s" FontSize="17" FontWeight="Bold" FontFamily="Consolas" Foreground="#F1F5F9" Margin="0,10,0,8"/>
                                            <TextBlock x:Name="MonProcText" Text="Processes: 0 | Uptime: 0h 0m" FontSize="13" FontFamily="Consolas" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 3: DESKTOP VISION -->
                        <TabItem Header="Vision">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                            <Button Content="Capture Screenshot" Style="{StaticResource PrimaryButtonStyle}" Click="OnCaptureScreenshotClick" Margin="0,0,8,0"/>
                                            <Button Content="Open in Viewer" Style="{StaticResource SecondaryButtonStyle}" Click="OnOpenScreenshotClick" Margin="0,0,8,0"/>
                                            <Button Content="Copy Path" Style="{StaticResource SecondaryButtonStyle}" Click="OnCopyScreenshotPathClick"/>
                                        </StackPanel>
                                        <TextBlock x:Name="VisionMetaText" DockPanel.Dock="Right" Text="No screenshot captured yet"
                                                   FontFamily="Consolas" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <Border Grid.Row="1" Background="#070B12" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14">
                                    <Image x:Name="VisionPreviewImage" Stretch="Uniform"/>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 4: SECURITY & POLICY -->
                        <TabItem Header="Security">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,14">
                                                <TextBlock Text="FOUR-TIER EXECUTION GUARDRAILS" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Content="Full Desktop" Style="{StaticResource SecondaryButtonStyle}" Click="OnPresetFullClick" Margin="0,0,6,0"/>
                                                    <Button Content="Workstation" Style="{StaticResource SecondaryButtonStyle}" Click="OnPresetWorkstationClick" Margin="0,0,6,0"/>
                                                    <Button Content="Lockdown" Style="{StaticResource DangerButtonStyle}" Click="OnPresetLockdownClick"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <CheckBox x:Name="PolAllowWritesChk" Style="{StaticResource ToggleSwitchStyle}" Content="Allow Tier 2: Workspace file writes &amp; project tests"/>
                                            <CheckBox x:Name="PolAllowTier3Chk" Style="{StaticResource ToggleSwitchStyle}" Content="Allow Tier 3: Sensitive operations (screenshots, edits, backups)"/>
                                            <CheckBox x:Name="PolAllowTier4Chk" Style="{StaticResource ToggleSwitchStyle}" Content="Allow Tier 4: High-risk operations (requires explicit human approval)"/>
                                            <CheckBox x:Name="PolAllowShellChk" Style="{StaticResource ToggleSwitchStyle}" Content="Allow Shell Execution (run_shell)"/>
                                            <CheckBox x:Name="PolAllowDesktopChk" Style="{StaticResource ToggleSwitchStyle}" Content="Allow Interactive Desktop Input (mouse / keyboard)"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                                <Button Content="Save Local Policy" Style="{StaticResource PrimaryButtonStyle}" Click="OnSavePolicyClick" Margin="0,0,8,0"/>
                                                <Button Content="Sync to Server" Style="{StaticResource SecondaryButtonStyle}" Click="OnSyncPolicyClick" Margin="0,0,8,0"/>
                                                <Button Content="Fetch from Server" Style="{StaticResource SecondaryButtonStyle}" Click="OnFetchPolicyClick"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="ALLOWED APPLICATION MATRIX" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,12"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBox x:Name="NewAppBox" Width="260" Style="{StaticResource SaaSTextBoxStyle}" Margin="0,0,8,0"/>
                                                <Button Content="Add App" Style="{StaticResource SecondaryButtonStyle}" Click="OnAddAllowedAppClick" Margin="0,0,8,0"/>
                                                <Button Content="Remove Selected" Style="{StaticResource DangerButtonStyle}" Click="OnRemoveAllowedAppClick"/>
                                            </StackPanel>
                                            <ListBox x:Name="AllowedAppsList" Height="150" Background="#0B111E" Foreground="#F1F5F9"
                                                     BorderBrush="#1E293B" BorderThickness="1" FontFamily="Consolas" Padding="6"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 5: SETTINGS -->
                        <TabItem Header="Settings">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="CONTROL PLANE &amp; CLIENT CONFIGURATION" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,16"/>

                                        <TextBlock Text="Control Plane URL" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,5"/>
                                        <TextBox x:Name="SetControlUrlBox" Style="{StaticResource SaaSTextBoxStyle}" FontFamily="Consolas" Margin="0,0,0,14"/>

                                        <TextBlock Text="Device ID" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,5"/>
                                        <TextBox x:Name="SetDeviceIdBox" Style="{StaticResource SaaSTextBoxStyle}" FontFamily="Consolas" Margin="0,0,0,14"/>

                                        <TextBlock Text="Device Token (DPAPI-sealed in ~/.ai-bridge/device.token)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,5"/>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="SetTokenPasswordBox" Style="{StaticResource SaaSPasswordBoxStyle}" FontFamily="Consolas"/>
                                            <TextBox x:Name="SetTokenPlainBox" Visibility="Collapsed" Style="{StaticResource SaaSTextBoxStyle}" FontFamily="Consolas"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                                <Button x:Name="ToggleTokenVisBtn" Content="Show" Style="{StaticResource SecondaryButtonStyle}" Click="OnToggleTokenVisClick" Margin="0,0,6,0"/>
                                                <Button Content="Copy" Style="{StaticResource SecondaryButtonStyle}" Click="OnCopyTokenClick" Margin="0,0,6,0"/>
                                                <Button Content="Reload" Style="{StaticResource SecondaryButtonStyle}" Click="OnReloadTokenClick"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Workspace Confinement Directory" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,5"/>
                                        <TextBox x:Name="SetWorkspaceBox" Style="{StaticResource SaaSTextBoxStyle}" FontFamily="Consolas" Margin="0,0,0,14"/>

                                        <TextBlock Text="Long-Poll Interval (seconds, 5–30)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,5"/>
                                        <TextBox x:Name="SetPollIntervalBox" Width="120" HorizontalAlignment="Left" Style="{StaticResource SaaSTextBoxStyle}" FontFamily="Consolas" Margin="0,0,0,16"/>

                                        <CheckBox x:Name="SetAutoStartChk" Style="{StaticResource ToggleSwitchStyle}" Content="Launch automatically when Windows starts (HKCU Run)"/>
                                        <CheckBox x:Name="SetAutoConnectChk" Style="{StaticResource ToggleSwitchStyle}" Content="Connect to Control Plane automatically on startup" Margin="0,6,0,18"/>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Save Configuration" Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveSettingsClick" Margin="0,0,8,0"/>
                                            <Button Content="Reset Defaults" Style="{StaticResource DangerButtonStyle}" Click="OnResetSettingsClick"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>

            <!-- Bottom Status Footer -->
            <Border Grid.Row="2" Background="#0C111D" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="14,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FooterStatusText" DockPanel.Dock="Left" Text="Ready" FontSize="11" FontFamily="Consolas" Foreground="#64748B"/>
                    <TextBlock x:Name="FooterWorkspaceText" DockPanel.Dock="Right" Text="" FontSize="11" FontFamily="Consolas" Foreground="#475569"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
